<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Scanner de site SaaS gratuit · Le Studio</title>
<meta name="description" content="Score sur 100 de votre site en 30 secondes : homepage, visibilité dans les IA, blog, vitesse et pages manquantes. Gratuit, sans email."/>
<link rel="canonical" href="https://www.lestudiodesign.fr/scanner/"/>
<meta property="og:title" content="Scanner de site SaaS gratuit · Le Studio"/>
<meta property="og:description" content="Score sur 100 de votre site en 30 secondes. Gratuit, sans email."/>
<meta property="og:url" content="https://www.lestudiodesign.fr/scanner/"/>
<meta property="og:image" content="https://www.lestudiodesign.fr/static/og-image.jpg"/>
<link href="/static/favicon.svg" rel="icon" type="image/svg+xml"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Fragment+Mono&family=Geist:wght@300..600&display=swap" rel="stylesheet"/>
<style>
:root{
  --bg:#EFEFEC;--white:#FAFAF8;--grey:#DEDEDA;--ink:#0D0D0D;--ink-2:#5B5B57;--line:rgb(13 13 13 / .14);
  --night:#0D0D0D;--night-2:#191918;--on-night:#F2F2EF;--on-night-2:#9C9C97;--line-night:rgb(242 242 239 / .16);
  --accent:#FF4D00;--on-accent:#0D0D0D;
  --font:"Geist",system-ui,-apple-system,"Segoe UI",sans-serif;
  --mono:"Fragment Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
  --gutter:clamp(16px,3vw,44px);--inset:clamp(8px,.9vw,14px);
  --r-frame:clamp(18px,2vw,30px);--r-md:clamp(12px,1.2vw,18px);--r-pill:999px;
  --ease-out:cubic-bezier(.23,1,.32,1);
}
*{box-sizing:border-box;margin:0;padding:0}
html{background:var(--bg)}
body{background:var(--bg);color:var(--ink);font-family:var(--font);font-size:1.0625rem;line-height:1.5;-webkit-font-smoothing:antialiased;overflow-x:clip}
a{color:inherit;text-decoration:none}
button,input{font:inherit}
.frame{margin:var(--inset);border-radius:var(--r-frame);background:var(--night);color:var(--on-night);position:relative;overflow:hidden}
.frame::before{content:"";position:absolute;inset:0;background:radial-gradient(120% 80% at 85% 0%,rgb(255 77 0 / .14),transparent 60%);pointer-events:none}
.wrap{padding-inline:var(--gutter);max-width:1360px;margin:0 auto;position:relative}
header.top{display:flex;align-items:center;justify-content:space-between;padding-block:clamp(18px,2.2vw,30px)}
.logo{font-weight:500;font-size:19px;letter-spacing:-.02em;display:inline-flex;align-items:center;gap:8px}
.logo::after{content:"";width:9px;height:9px;background:var(--accent)}
.pill{display:inline-flex;align-items:center;justify-content:center;gap:10px;border-radius:var(--r-pill);padding:12px 22px;font-weight:450;font-size:15.5px;line-height:1.2;transition:transform .3s var(--ease-out),background .3s var(--ease-out),border-color .3s}
.pill.accent{background:var(--accent);color:var(--on-accent)}
.pill.accent:hover{transform:translateY(-1px)}
.pill.ghost{border:1px solid var(--line-night);color:var(--on-night)}
.pill.ghost:hover{border-color:var(--on-night-2)}
.eyebrow{font-family:var(--mono);font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;display:inline-flex;align-items:center;gap:10px;color:var(--on-night-2)}
.eyebrow::before{content:"";width:8px;height:8px;background:var(--accent);flex:none}
.eyebrow.dark{color:var(--ink-2)}
.hero{padding-block:clamp(48px,7vw,110px) clamp(40px,6vw,90px)}
h1{font-weight:400;font-size:clamp(2.5rem,6vw,5.6rem);letter-spacing:-.05em;line-height:1;margin:24px 0 22px;max-width:13em}
h1 span{color:var(--on-night-2)}
.lede{color:var(--on-night-2);font-size:clamp(1.05rem,1.3vw,1.25rem);max-width:36em;margin-bottom:36px}
.sc-form{display:flex;gap:8px;max-width:640px;background:var(--night-2);border:1px solid var(--line-night);border-radius:var(--r-pill);padding:6px}
.sc-form input{flex:1;min-width:0;background:transparent;border:0;color:var(--on-night);padding:12px 18px;font-size:17px}
.sc-form input::placeholder{color:var(--on-night-2)}
.sc-form input:focus{outline:none}
.sc-form:focus-within{border-color:var(--on-night-2)}
.sc-form button{border:0;cursor:pointer;white-space:nowrap}
.sc-form button:disabled{opacity:.5;cursor:default}
.hint{font-family:var(--mono);font-size:12px;color:var(--on-night-2);margin-top:16px;letter-spacing:.02em}
.status{margin-top:28px;font-size:16px;color:var(--on-night);display:none;align-items:center;gap:12px}
.status.on{display:flex}
.status i{width:10px;height:10px;background:var(--accent);animation:blink 1s steps(2) infinite}
@keyframes blink{50%{opacity:.2}}
.err{margin-top:24px;display:none;border:1px solid var(--accent);color:var(--on-night);border-radius:var(--r-md);padding:14px 18px;max-width:640px}
.err.on{display:block}
@media (max-width:560px){.sc-form{flex-direction:column;border-radius:var(--r-md)}.sc-form button{width:100%}}

main{padding-block:clamp(48px,6vw,96px)}
.result{display:none}
.result.on{display:block}
.score-row{display:grid;grid-template-columns:minmax(0,auto) minmax(0,1fr);gap:clamp(24px,5vw,80px);align-items:end;padding-bottom:clamp(36px,4vw,56px);border-bottom:1px solid var(--line)}
@media (max-width:760px){.score-row{grid-template-columns:1fr;align-items:start}}
.big{font-weight:400;font-size:clamp(7rem,18vw,15rem);letter-spacing:-.07em;line-height:.82}
.big small{font-family:var(--mono);font-size:clamp(14px,1.2vw,16px);letter-spacing:.04em;color:var(--ink-2);margin-left:10px}
.site{font-size:clamp(1.4rem,2.2vw,2rem);letter-spacing:-.03em;line-height:1.1;margin:14px 0 10px;overflow-wrap:anywhere}
.stack{display:inline-flex;font-family:var(--mono);font-size:12.5px;letter-spacing:.04em;text-transform:uppercase;border:1px solid var(--line);border-radius:var(--r-pill);padding:7px 14px;margin-bottom:16px}
.verdict{font-size:clamp(1.1rem,1.5vw,1.35rem);color:var(--ink-2);max-width:30em;letter-spacing:-.01em}
.bars{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:1px;background:var(--line);border-bottom:1px solid var(--line)}
@media (max-width:900px){.bars{grid-template-columns:repeat(2,minmax(0,1fr))}.bar:last-child:nth-child(odd){grid-column:1/-1}}
.bar{background:var(--bg);padding:24px 20px 26px 0}
.bar:nth-child(n+2){padding-left:20px}
@media (max-width:900px){.bar{padding-left:0 !important}.bar:nth-child(even){padding-left:20px !important}}
.bar p{font-family:var(--mono);font-size:12px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-2);margin-bottom:10px}
.bar b{font-weight:400;font-size:2.4rem;letter-spacing:-.05em;line-height:1}
.bar small{font-family:var(--mono);font-size:13px;color:var(--ink-2)}
.bar i{display:block;height:3px;background:var(--grey);margin-top:16px}
.bar i em{display:block;height:100%;background:var(--accent);transition:width 1s var(--ease-out)}
section.block{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2.2fr);gap:clamp(20px,4vw,64px);padding-block:clamp(40px,5vw,72px);border-bottom:1px solid var(--line)}
@media (max-width:860px){section.block{grid-template-columns:1fr}}
h2{font-weight:400;font-size:clamp(1.9rem,3.2vw,3rem);letter-spacing:-.05em;line-height:1;margin-top:14px}
.recos{list-style:none;counter-reset:r}
.recos li{counter-increment:r;display:grid;grid-template-columns:52px 1fr;gap:12px;padding:18px 0;border-top:1px solid var(--line);font-size:clamp(1.05rem,1.3vw,1.2rem);letter-spacing:-.01em;line-height:1.45}
.recos li:first-child{border-top:0;padding-top:0}
.recos li::before{content:counter(r,decimal-leading-zero);font-family:var(--mono);font-size:13px;color:var(--accent);padding-top:5px}
.missing{display:flex;flex-wrap:wrap;align-items:flex-start;align-content:flex-start;gap:10px}
.missing span{border:1px solid var(--ink);border-radius:var(--r-pill);padding:9px 16px;font-size:15px}
.checks{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px}
.card{background:var(--white);border-radius:var(--r-md);padding:22px 22px 18px;border:1px solid var(--line)}
.card h3{font-family:var(--mono);font-weight:400;font-size:12.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-2);margin-bottom:12px}
.card ul{list-style:none}
.card li{display:grid;grid-template-columns:18px 1fr;gap:8px;font-size:15px;line-height:1.45;padding:6px 0;color:var(--ink-2)}
.card li::before{font-family:var(--mono);font-size:13px}
.card li.ok{color:var(--ink)}
.card li.ok::before{content:"✓"}
.card li.ko::before{content:"✕";color:var(--accent)}
.card li.info::before{content:"·"}
.note{font-family:var(--mono);font-size:12px;color:var(--ink-2);margin-top:16px;letter-spacing:.02em}
.cta{padding-block:clamp(56px,7vw,110px)}
.cta h2{font-size:clamp(2.4rem,5.4vw,5rem);max-width:12em;margin:22px 0 20px}
.cta p{color:var(--on-night-2);max-width:34em;font-size:clamp(1.05rem,1.3vw,1.2rem);margin-bottom:32px}
.cta .row{display:flex;gap:10px;flex-wrap:wrap}
.cta .avatar{width:28px;height:28px;border-radius:50%;object-fit:cover;margin-left:-10px}
footer{padding:28px var(--gutter) 40px;font-family:var(--mono);font-size:12px;color:var(--ink-2);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
@media (prefers-reduced-motion:reduce){*{animation:none !important;transition:none !important}}
</style>
</head>
<body>

<div class="frame">
  <div class="wrap">
    <header class="top">
      <a class="logo" href="/">Le Studio</a>
      <a class="pill accent" href="{{ settings.rdv }}" target="_blank" rel="noopener" data-cal-namespace="20min" data-cal-link="sacha-vetzikian/20min">Réserver un appel</a>
    </header>
    <div class="hero">
      <p class="eyebrow">Scanner gratuit · Sites SaaS B2B</p>
      <h1>Votre site convertit. <span>Ou il laisse filer vos démos.</span></h1>
      <p class="lede">Collez l'adresse de votre site. En 30 secondes : un score sur 100, votre homepage, votre visibilité dans ChatGPT et les IA, votre blog, votre vitesse et les pages qui manquent. Gratuit, sans email.</p>
      <form class="sc-form" id="sc-form">
        <label for="sc-url" style="position:absolute;left:-9999px">Adresse du site</label>
        <input id="sc-url" name="url" type="text" inputmode="url" autocomplete="url" placeholder="votresaas.com" required/>
        <button class="pill accent" type="submit" id="sc-btn">Scanner mon site</button>
      </form>
      <p class="hint">Homepage publique, robots.txt, sitemap et blog. Rien n'est stocké.</p>
      <p class="status" id="sc-loading" aria-live="polite"><i></i><span>Analyse en cours : homepage, robots IA, sitemap, blog, vitesse… 20 à 40 secondes.</span></p>
      <div class="err" id="sc-err" role="alert"></div>
    </div>
  </div>
</div>

<main class="wrap result" id="sc-result" aria-live="polite">
  <div class="score-row">
    <div>
      <p class="eyebrow dark">Score global</p>
      <p class="big"><span id="sc-score-n">0</span><small>/ 100</small></p>
    </div>
    <div>
      <p class="site" id="sc-site"></p>
      <p class="stack" id="sc-stack"></p>
      <p class="verdict" id="sc-verdict"></p>
    </div>
  </div>
  <div class="bars" id="sc-bars"></div>

  <section class="block">
    <div><p class="eyebrow dark">À faire en premier</p><h2>Les priorités</h2></div>
    <ol class="recos" id="sc-recos"></ol>
  </section>

  <section class="block" id="sc-missing-wrap">
    <div><p class="eyebrow dark">Ce que cherchent vos acheteurs</p><h2>Pages manquantes</h2></div>
    <div class="missing" id="sc-missing"></div>
  </section>

  <section class="block">
    <div><p class="eyebrow dark">Point par point</p><h2>Le détail</h2></div>
    <div>
      <div class="checks" id="sc-checks"></div>
      <p class="note" id="sc-note"></p>
    </div>
  </section>
</main>

<div class="frame result" id="sc-cta">
  <div class="wrap cta">
    <p class="eyebrow">Analyse vidéo offerte</p>
    <h2>Je vous fais la vidéo de 2 minutes sur votre site.</h2>
    <p>Le score donne la direction. Pour savoir quoi changer en premier, je passe sur votre site page par page, en vidéo, avec des recommandations concrètes. Gratuit, par passion du sujet.</p>
    <div class="row">
      <a class="pill accent" href="{{ settings.rdv }}" target="_blank" rel="noopener" data-cal-namespace="20min" data-cal-link="sacha-vetzikian/20min"><img class="avatar" src="/sacha-avatar.webp" alt="Sacha Vetzikian" width="28" height="28" loading="lazy" style="margin-left:-10px"/>Recevoir mon analyse vidéo</a>
      <a class="pill ghost" href="#" id="sc-again">Scanner un autre site</a>
    </div>
  </div>
</div>

<footer>
  <span>© Le Studio · Sacha et Jérémy</span>
  <span>Webflow · Framer · Astro</span>
</footer>

<script>
(function(){
  var form=document.getElementById('sc-form'),input=document.getElementById('sc-url'),btn=document.getElementById('sc-btn');
  var loading=document.getElementById('sc-loading'),err=document.getElementById('sc-err');
  var result=document.getElementById('sc-result'),cta=document.getElementById('sc-cta');
  var ORDER=['homepage','ia','blog','vitesse','pages'];
  var TITLES={homepage:'Homepage',ia:'Visibilité IA',blog:'Blog',vitesse:'Vitesse',pages:'Pages clés'};

  function el(tag,cls,text){var n=document.createElement(tag);if(cls)n.className=cls;if(text!=null)n.textContent=text;return n;}
  function verdict(s){
    if(s>=85)return "Très bon niveau. Les gains se jouent maintenant sur les détails qui font signer.";
    if(s>=65)return "Une bonne base, mais plusieurs fuites coûtent des demandes de démo chaque mois.";
    if(s>=45)return "Le site freine la croissance : il manque des éléments clés pour convertir et être cité par les IA.";
    return "Le site ne travaille pas pour vous. C'est le bon moment pour le reprendre en main.";
  }
  function countUp(node,to){
    var start=performance.now(),dur=900;
    if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){node.textContent=to;return;}
    (function step(t){var k=Math.min(1,(t-start)/dur);node.textContent=Math.round(to*(1-Math.pow(1-k,3)));if(k<1)requestAnimationFrame(step);})(start);
  }

  function render(d){
    var s=Math.max(0,Math.min(100,d.score));
    countUp(document.getElementById('sc-score-n'),s);
    document.getElementById('sc-site').textContent=d.url.replace(/^https?:\/\//,'').replace(/\/$/,'');
    document.getElementById('sc-stack').textContent='Stack : '+d.stack+(d.plugins?' · '+d.plugins+' plugins visibles':'');
    document.getElementById('sc-verdict').textContent=verdict(s);

    var bars=document.getElementById('sc-bars');bars.innerHTML='';
    d.sections.forEach(function(x){
      var b=el('div','bar');b.appendChild(el('p',null,x.label));
      b.appendChild(el('b',null,String(x.score)));b.appendChild(el('small',null,' / '+x.max));
      var i=el('i'),e=el('em');e.style.width='0%';i.appendChild(e);b.appendChild(i);bars.appendChild(b);
      setTimeout(function(){e.style.width=(x.max?Math.round(x.score/x.max*100):0)+'%';},60);
    });

    var recos=document.getElementById('sc-recos');recos.innerHTML='';
    (d.recos.length?d.recos:["Rien de bloquant détecté automatiquement. La vidéo permet d'aller plus loin sur le message et le parcours."]).forEach(function(r){recos.appendChild(el('li',null,r));});

    var missing=d.details.pages.filter(function(p){return !p.found;});
    var mw=document.getElementById('sc-missing-wrap'),m=document.getElementById('sc-missing');m.innerHTML='';
    mw.style.display=missing.length?'':'none';
    missing.forEach(function(p){m.appendChild(el('span',null,p.label));});

    var checks=document.getElementById('sc-checks');checks.innerHTML='';
    ORDER.forEach(function(key){
      var list=d.checks.filter(function(c){return c.section===key;});if(!list.length)return;
      var card=el('div','card');card.appendChild(el('h3',null,TITLES[key]));var ul=el('ul');
      list.forEach(function(c){ul.appendChild(el('li',c.ok===true?'ok':c.ok===false?'ko':'info',c.label));});
      card.appendChild(ul);checks.appendChild(card);
    });
    document.getElementById('sc-note').textContent=d.details.speed.psi?'Vitesse mesurée avec Google PageSpeed (mobile).':"Vitesse estimée à partir du temps de réponse et du poids de la page. La vidéo d'analyse inclut un test PageSpeed complet.";

    result.classList.add('on');cta.classList.add('on');
    result.scrollIntoView({behavior:'smooth',block:'start'});
  }

  async function scan(url){
    err.classList.remove('on');result.classList.remove('on');cta.classList.remove('on');
    loading.classList.add('on');btn.disabled=true;
    try{
      var r=await fetch('/api/scan',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({url:url})});
      var d=await r.json().catch(function(){return {};});
      if(!r.ok)throw new Error(d.message||"L'analyse a échoué, réessayez dans un instant.");
      render(d);
      try{history.replaceState(null,'','?url='+encodeURIComponent(url));}catch(e){}
    }catch(e){err.textContent=e.message;err.classList.add('on');}
    finally{loading.classList.remove('on');btn.disabled=false;}
  }

  form.addEventListener('submit',function(e){e.preventDefault();var v=input.value.trim();if(v)scan(v);});
  document.getElementById('sc-again').addEventListener('click',function(e){e.preventDefault();input.value='';window.scrollTo({top:0,behavior:'smooth'});setTimeout(function(){input.focus();},400);});
  // Lien partageable : /scanner/?url=exemple.com lance l'analyse directement.
  var q=new URLSearchParams(location.search).get('url');
  if(q){input.value=q;scan(q);}
})();
</script>
<script>
(function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
Cal("init", "20min", {origin:"https://cal.com"});
Cal.ns["20min"]("ui", {"hideEventTypeDetails":false,"layout":"month_view"});
</script>
</body>
</html>
