---
layout: layouts/base.njk
permalink: /cas-clients/
seo_title: Cas clients · Refontes UX/UI e-commerce et vitrine · LeStudio
seo_description: Toutes nos réalisations UX/UI, e-commerce et vitrine. Yves Rocher, Cuure, Juliette Has A Gun, Caalme, Apoticaria et plus.
---
{% set crumbs = [ {name:"Accueil", url:"/"}, {name:"Cas clients"} ] %}
{% include "partials/breadcrumb.njk" %}
<h1 style="margin-top:16px;">Des marques qui nous ont fait <em>confiance.</em></h1>
<p class="lede">Chaque projet part du même point : un site qui ne convertit pas à la hauteur de la marque.</p>

<div class="filter-tabs" id="filterTabs">
<button class="filter-tab active" data-filter="all">Toutes</button>
{% for s in collections.secteurs %}
{% if (collections.realisations | inSecteur(s.fileSlug) | length) > 0 %}
<button class="filter-tab" data-filter="{{ s.fileSlug }}">{{ s.data.title }}</button>
{% endif %}
{% endfor %}
</div>

<div class="case-grid" id="caseGrid">
{% for r in collections.realisations %}
<a class="case-card" data-secteur="{{ r.data.secteur or '' }}" href="/realisations/{{ r.fileSlug }}/">
{% if r.data.cover and (r.data.cover | assetExists) %}
<div class="case-preview">
<div class="case-browser-bar"><span class="case-browser-dot red"></span><span class="case-browser-dot yellow"></span><span class="case-browser-dot green"></span><span class="case-browser-url"></span></div>
<div class="case-shot"><img src="{{ r.data.cover }}" alt="{{ r.data.client }}" loading="lazy"/></div>
</div>
{% endif %}
<span class="case-badge"><span class="case-badge-icon"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg></span>{% if r.data.type == "ecommerce" %}E-commerce{% else %}Vitrine{% endif %} · {{ r.data.tags[0] }}</span>
<h3>{{ r.data.client }}</h3>
{% if r.data.resultats %}<p style="font-family:'DM Sans',sans-serif;font-size:22px;font-weight:600;color:var(--orange);margin:4px 0 8px;">{{ r.data.resultats[0].chiffre }} <span style="font-size:13px;font-weight:400;color:var(--grey);">{{ r.data.resultats[0].label }}</span></p>{% endif %}
<p>{{ r.data.description }}</p>
<div class="case-divider"></div>
<span class="case-link">→ Voir le projet</span>
</a>
{% endfor %}
</div>

<a class="btn-primary" href="{{ settings.rdv }}" target="_blank" rel="noopener" data-cal-namespace="20min" data-cal-link="sacha-vetzikian/20min"><img alt="Sacha Vetzikian, fondateur de LeStudio" class="avatar avatar-inline" height="36" loading="lazy" src="/sacha-avatar.webp" width="36"/><span>Prendre rendez-vous avec Sacha</span></a>

<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"BreadcrumbList",
 "itemListElement":[
  {"@type":"ListItem","position":1,"name":"Accueil","item":"https://www.lestudiodesign.fr/"},
  {"@type":"ListItem","position":2,"name":"Cas clients","item":"https://www.lestudiodesign.fr/cas-clients/"}
 ]
}
</script>

<script>
(function(){
  var tabs = document.querySelectorAll('#filterTabs .filter-tab');
  var cards = document.querySelectorAll('#caseGrid .case-card');
  tabs.forEach(function(tab){
    tab.addEventListener('click', function(){
      tabs.forEach(function(t){ t.classList.remove('active'); });
      tab.classList.add('active');
      var filter = tab.getAttribute('data-filter');
      cards.forEach(function(card){
        var show = filter === 'all' || card.getAttribute('data-secteur') === filter;
        card.style.display = show ? '' : 'none';
      });
    });
  });
})();
</script>
