---
layout: layouts/base.njk
permalink: /cas-clients/
seo_title: Cas clients · Refontes UX/UI Webflow · LeStudio
seo_description: Toutes nos réalisations UX/UI & Webflow, e-commerce et vitrine. Yves Rocher, Cuure, Juliette Has A Gun, Caalme, Apoticaria et plus.
---
{% set crumbs = [ {name:"Accueil", url:"/"}, {name:"Cas clients"} ] %}
{% include "partials/breadcrumb.njk" %}
<h1 style="margin-top:16px;">Des marques qui nous ont fait <em>confiance.</em></h1>
<p class="lede">Chaque projet part du même point : un site qui ne convertit pas à la hauteur de la marque.</p>

<div class="filter-tabs" id="filterTabs">
<button class="filter-tab active" data-filter="all">Toutes</button>
{% for s in collections.secteurs %}
{% if (collections.realisations | inSecteur(s.fileSlug) | length) > 0 %}
<button class="filter-tab" data-filter="{{ s.fileSlug }}">{{ s.data.title }}</button>
{% endif %}
{% endfor %}
</div>

<div class="case-list" id="caseGrid">
{% for r in collections.realisations %}
<a class="case-row" data-secteur="{{ r.data.secteur or '' }}" href="/realisations/{{ r.fileSlug }}/">
<span class="case-row-year">{{ r.data.year }}</span>
<div class="case-row-title">
<h3>{{ r.data.client }}</h3>
<div class="case-row-meta"><span>{% if r.data.type == "ecommerce" %}Refonte e-commerce{% else %}Refonte site vitrine{% endif %}</span>{% for tag in r.data.tags %}<span>· {{ tag }}</span>{% endfor %}{% if r.data.resultats %}<span>· {{ r.data.resultats[0].chiffre }} {{ r.data.resultats[0].label }}</span>{% endif %}</div>
</div>
{% if r.data.cover and (r.data.cover | assetExists) %}
<div class="case-row-thumb"><img src="{{ r.data.cover }}" alt="{{ r.data.client }}" loading="lazy"/></div>
{% endif %}
<span class="case-row-arrow"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></span>
</a>
{% endfor %}
</div>

<a class="link-cta" style="margin:0 0 80px;" href="{{ settings.rdv }}" target="_blank" rel="noopener" data-cal-namespace="20min" data-cal-link="sacha-vetzikian/20min">Prendre rendez-vous avec Sacha<span class="arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></span></a>

<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"BreadcrumbList",
 "itemListElement":[
  {"@type":"ListItem","position":1,"name":"Accueil","item":"https://www.lestudiodesign.fr/"},
  {"@type":"ListItem","position":2,"name":"Cas clients","item":"https://www.lestudiodesign.fr/cas-clients/"}
 ]
}
</script>

<script>
(function(){
  var tabs = document.querySelectorAll('#filterTabs .filter-tab');
  var cards = document.querySelectorAll('#caseGrid .case-row');
  tabs.forEach(function(tab){
    tab.addEventListener('click', function(){
      tabs.forEach(function(t){ t.classList.remove('active'); });
      tab.classList.add('active');
      var filter = tab.getAttribute('data-filter');
      cards.forEach(function(card){
        var show = filter === 'all' || card.getAttribute('data-secteur') === filter;
        card.style.display = show ? '' : 'none';
      });
    });
  });
})();
</script>
