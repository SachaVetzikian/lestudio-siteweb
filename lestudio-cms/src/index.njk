<script>
  (function(){
    var CONSENT_KEY = 'lestudio_cookie_consent';
    var CONSENT_MAX_AGE_DAYS = 180;
    var banner = document.getElementById('cookieBanner');
    var reopenBtn = document.getElementById('reopenCookies');

    function readConsent(){
      try{
        var raw = localStorage.getItem(CONSENT_KEY);
        if(!raw) return null;
        var data = JSON.parse(raw);
        var ageDays = (Date.now() - data.ts) / (1000 * 60 * 60 * 24);
        if(ageDays > CONSENT_MAX_AGE_DAYS) return null;
        return data.choice;
      } catch(e){ return null; }
    }

    function writeConsent(choice){
      localStorage.setItem(CONSENT_KEY, JSON.stringify({ choice: choice, ts: Date.now() }));
    }

    function loadTracking(){
      window.dataLayer = window.dataLayer || [];
      dataLayer.push({'gtm.start': new Date().getTime(), event:'gtm.js'});
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-5CQH5JQ5';
      document.head.appendChild(s);
      // GA4 (G-352739794) à configurer comme tag "Google Analytics : Configuration GA4"
      // dans l'interface Google Tag Manager, déclenché sur "All Pages". Pas possible
      // de le faire depuis le code, ça se passe sur tagmanager.google.com.
    }

    function showBanner(){ banner.style.display = 'block'; }
    function hideBanner(){ banner.style.display = 'none'; }

    var existing = readConsent();
    if(existing === 'granted'){
      loadTracking();
    } else if(existing === null){
      showBanner();
    }

    document.getElementById('cookieAccept').onclick = function(){
      writeConsent('granted');
      hideBanner();
      loadTracking();
    };
    document.getElementById('cookieRefuse').onclick = function(){
      writeConsent('denied');
      hideBanner();
    };
    if(reopenBtn){
      reopenBtn.onclick = function(){ showBanner(); };
    }
    if(window.location.hash === '#cookies'){
      showBanner();
    }
  })();
</script>


<script>
  (function(){
    var burger = document.getElementById('burger');
    var menu = document.getElementById('mobileMenu');
    if(!burger || !menu) return;
    function toggle(force){
      var open = force !== undefined ? force : !menu.classList.contains('open');
      menu.classList.toggle('open', open);
      burger.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open);
      menu.setAttribute('aria-hidden', !open);
    }
    burger.addEventListener('click', function(){ toggle(); });
    menu.querySelectorAll('a').forEach(function(a){ a.addEventListener('click', function(){ toggle(false); }); });
  })();
</script>

