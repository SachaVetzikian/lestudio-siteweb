<meta content="Agence UX UI Design &amp; CRO - Le Studio | Paris" name="twitter:title"/>
<meta content="Audit UX/UI, refonte e-commerce et vitrine, design par abonnement." name="twitter:description"/>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<style>
  :root{
    --ink:#09090b; --slate:#27272a; --paper:#f4f4f5; --orange:#ff5a00; --orange-light:#ffe4d6; --grey:#3f3f46;
    --line:#ececee;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{overflow-x:hidden;}
  body{font-family:'DM Sans',sans-serif; background:var(--paper); color:var(--ink); -webkit-font-smoothing:antialiased;}
  a{color:inherit; text-decoration:none;}
  @media (prefers-reduced-motion: reduce){ .spin{animation:none !important;} }

  .wrap{width:100%; margin:0 auto; padding:0 32px; box-sizing:border-box;}
  .page-frame{margin:0 32px; border-left:1px solid var(--line); border-right:1px solid var(--line);}
  @media (min-width:1464px){ .page-frame{max-width:1400px; margin:0 auto;} }
  @media (max-width:640px){ .page-frame{margin:0 14px;} }

  header.nav{
    position:sticky; top:0; z-index:100;
    background:rgba(244,244,245,0.75); backdrop-filter:blur(14px);
    border-bottom:1px solid var(--line);
    transition:background .3s ease, box-shadow .3s ease;
  }
  header.nav.scrolled{
    background:rgba(244,244,245,0.94);
    box-shadow:0 6px 24px -12px rgba(20,18,31,0.2);
  }
  header.nav.menu-open{background:var(--ink) !important; border-bottom-color:transparent; box-shadow:none;}
  header.nav.menu-open .logo{color:#fff;}
  header.nav.menu-open .burger span{background:#fff;}
  header.nav.menu-open .nav-cta{display:none;}
  .nav-inner{width:100%; box-sizing:border-box; padding:20px 32px; display:flex; align-items:center; justify-content:space-between;}
  @media (max-width:480px){ .nav-inner{padding:16px 16px;} }
  .logo{font-family:'DM Sans',sans-serif; font-size:20px; font-weight:600; display:flex; align-items:center; gap:8px;}
  .nav-links{display:flex; align-items:center; gap:36px; font-size:14px; font-weight:500;}
  @media (max-width:860px){ .nav-links{display:none;} }
  .nav-dropdown{position:relative;}
  .nav-dropdown-toggle{display:inline-flex; align-items:center; gap:6px; background:none; border:none; font:inherit; color:inherit; cursor:pointer; padding:0;}
  .nav-dropdown-toggle svg{transition:transform .2s ease;}
  .nav-dropdown:hover .nav-dropdown-toggle svg, .nav-dropdown.open .nav-dropdown-toggle svg{transform:rotate(180deg);}
  .nav-dropdown-menu{position:absolute; top:100%; left:50%; transform:translateX(-50%); padding-top:14px; display:none; z-index:110;}
  .nav-dropdown:hover .nav-dropdown-menu, .nav-dropdown.open .nav-dropdown-menu{display:block;}
  .nav-dropdown-menu-inner{
    background:#fff; border:1px solid var(--line); border-radius:14px; padding:8px;
    box-shadow:0 20px 40px -20px rgba(9,9,11,0.25); display:flex; flex-direction:column; min-width:210px;
  }
  .nav-dropdown-menu-inner a{padding:10px 14px; border-radius:8px; font-size:14px; font-weight:500; white-space:nowrap;}
  .nav-dropdown-menu-inner a:hover{background:var(--paper); color:var(--orange);}
  .nav-cta{
    font-size:13.5px; font-weight:400; background:var(--ink); color:#fff;
    padding:11px 20px; border-radius:100px;
  }
  .nav-cta .nav-cta-short{display:none !important;}
  @media (max-width:480px){
    .logo svg{width:100px; height:auto;}
    .nav-cta{padding:9px 14px;}
    .nav-cta .nav-cta-full{display:none !important;}
    .nav-cta .nav-cta-short{display:inline-flex !important;}
  }

  .hero{position:relative; overflow:hidden; padding:64px 0 60px; text-align:center;}
  .blob{position:absolute; border-radius:50%; filter:blur(80px); opacity:0.3; pointer-events:none;}
  .blob-2{width:340px; height:340px; background:radial-gradient(circle, #ffffff, transparent 70%); top:40px; right:-100px; opacity:0.6;}

  .badge{
    display:inline-flex; align-items:center; gap:8px; font-size:12px; letter-spacing:0.04em; text-transform:uppercase;
    border:1px solid var(--line); border-radius:999px; padding:8px 18px; margin-bottom:20px;
    background:rgba(255,255,255,0.6); position:relative; color:var(--ink);
  }

  h1{
    font-family:'DM Sans',sans-serif; font-weight:600; line-height:1.1; letter-spacing:-0.02em;
    font-size:clamp(38px, 5.2vw, 64px); max-width:820px; margin:0 auto 16px; position:relative; color:var(--ink);
    text-wrap:pretty;
  }
  h1 em{font-style:normal; font-weight:600; color:var(--orange);}

  .lede{font-size:15.5px; line-height:1.3; color:var(--ink); max-width:520px; margin:0 auto 28px; position:relative;}

  .cta-row{display:flex; align-items:center; justify-content:center; margin-bottom:20px; position:relative;}
  .btn-primary{
    color:#fff; background:var(--ink);
    font-family:'DM Sans',sans-serif; font-size:15px; font-weight:400;
    padding:10px 30px 10px 10px; border-radius:12px;
    display:flex; align-items:center; gap:12px; white-space:nowrap; max-width:100%;
  }
  @media (max-width:480px){
    .btn-primary{font-size:13.5px; padding:9px 18px 9px 8px; gap:8px; white-space:normal;}
  }

  .meta{font-size:13px; color:var(--grey); margin-bottom:36px; position:relative;}

  .trust{
    display:inline-flex; align-items:center; gap:12px; background:rgba(255,255,255,0.6);
    border:1px solid var(--line); border-radius:12px; padding:10px 20px; position:relative;
    text-decoration:none; color:inherit; transition:border-color .2s ease;
  }
  .trust:hover{border-color:var(--orange);}
  .trust .stack{display:flex;}
  .trust .count{font-size:12.5px; font-weight:500; text-transform:uppercase; letter-spacing:0.03em; color:var(--ink);}
  .trust .count-sub{font-size:12.5px; font-weight:500; color:var(--ink);}
  .trust-dark{background:transparent; border-color:transparent; transition:opacity .2s ease;}
  .trust-dark:hover{opacity:0.75;}
  .trust-stars{color:var(--orange); font-size:13px; letter-spacing:2px; line-height:1; margin-bottom:4px;}
  .section-break{position:relative; height:56px; width:100%; padding:0 32px; box-sizing:border-box;}
  .section-break.standalone{width:auto; margin:0 32px; padding:0;}
  @media (min-width:1464px){ .section-break.standalone{max-width:1400px; margin:0 auto;} }
  @media (max-width:640px){ .section-break.standalone{margin:0 14px;} }
  .section-break::before{content:''; position:absolute; top:28px; left:0; right:0; height:1px; background:var(--line);}
  .section-break .mark{position:absolute; top:40px; width:14px; height:14px; border-top:1.5px solid var(--grey);}
  .section-break .mark.left{left:0; border-left:1.5px solid var(--grey);}
  .section-break .mark.right{right:0; border-right:1.5px solid var(--grey);}

  .eyebrow{font-size:12px; text-transform:uppercase; letter-spacing:0.04em; color:var(--grey);}

  .marquee-wrap{overflow:hidden; padding:24px 0; border-top:1px solid var(--line); -webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent); mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);}
  .marquee-track{display:flex; width:max-content; animation:scroll-left 26s linear infinite;}
  .marquee-wrap:hover .marquee-track{animation-play-state:paused;}
  @media (prefers-reduced-motion: reduce){ .marquee-track{animation:none;} }
  .marquee-item{display:flex; align-items:center; padding:0 42px; font-family:'DM Sans',sans-serif; font-weight:600; font-size:18px; color:var(--grey); white-space:nowrap; opacity:0.7;}
  .marquee-item img{height:calc(34px * var(--logo-scale,1)); width:auto; filter:grayscale(1); opacity:0.8;}
  @media (max-width:640px){ .marquee-item{padding:0 28px;} .marquee-item img{height:calc(26px * var(--logo-scale,1));} }
  @media (max-width:640px){ .testimonial-wrap{padding-left:0; padding-right:0;} }
  @keyframes scroll-left{ from{transform:translateX(0);} to{transform:translateX(-50%);} }

  section{padding:80px 0;}
  .section-head{margin-bottom:48px;}
  .section-head h2{font-family:'DM Sans',sans-serif; font-weight:600; font-size:clamp(26px,3.4vw,40px); letter-spacing:-0.01em; margin-top:12px; max-width:640px;}
  .section-head p.section-intro{color:var(--grey); font-size:16px; max-width:520px; margin-top:14px; line-height:1.6;}

  .btn-secondary{
    background:transparent; color:var(--ink); border:1px solid var(--line);
    font-size:15px; font-weight:400; padding:14px 26px; border-radius:14px; display:inline-flex; align-items:center; gap:8px;
  }

  /* Cards grid: diagnostic, pourquoi */
  .card-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); border:1px solid var(--line); border-radius:12px; overflow:hidden;}
  @media (max-width:760px){ .card-grid{grid-template-columns:1fr;} }
  .card-grid.cols-4{grid-template-columns:repeat(4,1fr);}
  @media (max-width:960px){ .card-grid.cols-4{grid-template-columns:repeat(2,1fr);} }
  @media (max-width:600px){ .card-grid.cols-4{grid-template-columns:1fr;} }
  .card{background:var(--paper); padding:32px 28px; border-right:1px solid var(--line); margin-right:-1px;}
  .card svg{display:block; color:var(--orange); margin-bottom:14px;}
  .card h3{font-family:'DM Sans',sans-serif; font-weight:600; font-size:19px; margin-bottom:10px;}
  .card p{color:var(--grey); font-size:14.5px; line-height:1.6;}

  /* Method steps - scroll bloqué */
  .scroll-method{display:grid; grid-template-columns:140px 1fr; gap:48px;}
  @media (max-width:760px){ .scroll-method{grid-template-columns:1fr;} .scroll-side{display:none;} }
  .scroll-side{position:sticky; top:96px; align-self:start; height:fit-content;}
  .scroll-rail{position:relative; width:2px; height:180px; background:var(--line); border-radius:2px; margin-bottom:20px; overflow:hidden;}
  .scroll-rail-fill{position:absolute; top:0; left:0; width:100%; background:var(--orange); border-radius:2px; height:0%;}
  .scroll-num{font-family:'DM Sans',sans-serif; font-weight:600; font-size:44px; line-height:1; margin-top:8px; color:var(--orange);}
  .scroll-block{padding:48px 0; border-top:1px solid var(--line); transition:background .3s ease;}
  .scroll-block:last-child{border-bottom:1px solid var(--line);}
  .scroll-block.active{background:var(--orange-light);}
  .scroll-block.active p{color:var(--ink);}
  .scroll-block-inner{padding:8px 28px;}
  .step-duration{font-size:12px; text-transform:uppercase; letter-spacing:0.04em; color:var(--orange); font-weight:500;}
  .scroll-block h3{font-family:'DM Sans',sans-serif; font-weight:600; font-size:26px; margin:10px 0 14px;}
  .scroll-block p{color:var(--grey); font-size:15.5px; line-height:1.5; max-width:480px; margin-bottom:14px;}
  .deliverable{margin-top:4px; font-size:12.5px; color:var(--ink); font-weight:500;}

  /* Asset mockups riches - étapes méthode */
  .asset-mock{background:#fff; border:1px solid var(--line); border-radius:14px; overflow:hidden; max-width:300px; margin-top:22px; box-shadow:0 10px 28px -14px rgba(9,9,11,0.18);}
  .asset-mock .am-chrome{display:flex; align-items:center; justify-content:space-between; padding:9px 12px; border-bottom:1px solid var(--line);}
  .asset-mock .am-dots{display:flex; gap:5px;}
  .asset-mock .am-dots span{width:6px;height:6px;border-radius:50%;background:var(--line);}
  .asset-mock .am-label{font-size:10px; color:var(--grey); border:1px solid var(--line); border-radius:6px; padding:3px 9px; display:flex; align-items:center; gap:4px;}
  .asset-mock .am-body{padding:16px; position:relative; min-height:130px;}
  .asset-mock .am-toolbar{display:flex; gap:12px; padding:8px 14px; border-top:1px solid var(--line); color:var(--grey);}
  .asset-mock .am-cursor{position:absolute; background:var(--ink); color:#fff; font-size:9px; font-weight:500; padding:4px 9px; border-radius:8px 8px 8px 2px; white-space:nowrap;}
  .asset-mock .am-swatch{width:14px; height:14px; border-radius:4px; display:inline-block;}
  .am-wrap{position:relative; max-width:300px; margin-top:22px;}
  .am-wrap .asset-mock{margin-top:0;}
  .am-sticker{position:absolute; z-index:3; background:var(--orange); color:#fff; font-family:'DM Sans',sans-serif; font-weight:700; font-size:11px; padding:7px 14px; border-radius:8px; transform:rotate(-6deg); box-shadow:0 10px 24px -8px rgba(255,90,0,0.55); white-space:nowrap;}
  .am-chatbubble{display:inline-flex; align-items:center; gap:8px; background:#fff; border:1px solid var(--line); border-radius:16px; padding:9px 16px 9px 9px; font-size:12px; font-weight:600; color:var(--ink); box-shadow:0 10px 24px -12px rgba(9,9,11,0.2);}
  .am-chatbubble img{width:24px; height:24px; border-radius:50%; object-fit:cover; flex-shrink:0;}
  .am-timeline{position:relative; height:56px; margin:8px 0 16px;}
  .am-timeline .am-ruler{position:absolute; top:8px; left:0; right:0; height:1px; background:var(--line);}
  .am-timeline .am-marker{position:absolute; top:8px; width:1.5px; height:24px; background:var(--orange);}
  .am-timeline .am-marker::before{content:''; position:absolute; top:-4px; left:50%; transform:translateX(-50%); width:7px; height:7px; border-radius:50%; background:var(--orange); box-shadow:0 0 0 3px var(--orange-light);}
  .am-timeline .am-tick{position:absolute; top:40px; font-size:8.5px; color:var(--grey); font-family:monospace; letter-spacing:.02em; transform:translateX(-50%);}
  .am-timeline .am-tick:first-child{transform:none;}
  .am-timeline .am-tick:last-child{transform:translateX(-100%);}
  .am-filetag{display:inline-flex; align-items:center; gap:6px; border:1px dashed var(--line); border-radius:8px; padding:6px 10px; font-size:10px; color:var(--grey); font-family:monospace; background:#fff;}

  /* Offers */
  .pack-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); border:1px solid var(--line); border-radius:12px; overflow:hidden; margin-bottom:1px;}
  @media (max-width:860px){ .pack-grid{grid-template-columns:1fr;} }
  .pack{background:var(--paper); padding:32px 28px; display:flex; flex-direction:column;}
  .pack svg{color:var(--orange); margin-bottom:14px;}
  .pack h3{font-family:'DM Sans',sans-serif; font-weight:600; font-size:19px; margin-bottom:8px;}
  .pack p{color:var(--grey); font-size:14px; line-height:1.6; margin-bottom:16px; flex-grow:1;}
  .pack .price{font-size:13px; text-transform:uppercase; letter-spacing:0.03em; margin-bottom:18px;}
  .pack .btn-secondary{align-self:flex-start;}

  .offer-tabs{display:grid; grid-template-columns:repeat(3,1fr); border:1px solid var(--line); border-radius:12px; overflow:hidden; margin-bottom:40px;}
  @media (max-width:760px){ .offer-tabs{grid-template-columns:1fr;} }
  .offer-tab-card{background:var(--paper); border:none; border-right:1px solid var(--line); padding:28px 20px; text-align:center; cursor:pointer; font-family:'DM Sans',sans-serif;}
  .offer-tab-card:last-child{border-right:none;}
  .offer-tab-card.active{background:#fff; position:relative; box-shadow:0 10px 28px -14px rgba(9,9,11,0.2);}
  .offer-icon{display:flex; align-items:center; justify-content:center; margin:0 auto 14px; color:var(--grey);}
  .offer-tab-card.active .offer-icon{color:var(--orange);}
  .offer-tab-card h4{font-family:'DM Sans',sans-serif; font-weight:600; font-size:16px; color:var(--grey); margin-bottom:4px;}
  .offer-tab-card.active h4{color:var(--ink);}
  .offer-tab-card p{font-size:12.5px; color:var(--grey); margin-bottom:12px;}
  .offer-mini-stats{font-size:12px; color:var(--grey);}
  .offer-tab-card.active .offer-mini-stats{color:var(--orange); font-weight:500;}
  .offer-panel{display:none; grid-template-columns:1fr 1.1fr 0.8fr; gap:32px; padding-bottom:24px;}
  .offer-panel.active{display:grid;}
  @media (max-width:960px){ .offer-panel.active{grid-template-columns:1fr;} }
  .offer-col h3{font-family:'DM Sans',sans-serif; font-weight:600; font-size:24px; margin:10px 0 22px; color:var(--ink);}
  .offer-block{margin-bottom:18px;}
  .offer-block h4{font-size:11.5px; text-transform:uppercase; letter-spacing:0.03em; color:var(--grey); margin-bottom:6px;}
  .offer-block p{font-size:14.5px; line-height:1.6; color:var(--ink); margin:0;}
  .offer-tags{display:flex; gap:8px; flex-wrap:wrap;}
  .offer-tags span{display:inline-flex; align-items:center; gap:6px; font-size:12px; border:1px solid var(--line); border-radius:12px; padding:5px 12px; color:var(--ink);}
  .offer-included-title{font-family:'DM Sans',sans-serif; font-weight:600; font-size:15px; margin-bottom:14px;}
  .offer-check{display:flex; align-items:center; gap:10px; background:rgba(34,150,80,0.08); border-radius:8px; padding:11px 14px; margin-bottom:8px; font-size:13.5px; color:var(--ink);}
  .offer-check svg{color:#229650; flex-shrink:0;}
  .offer-stats{background:var(--slate); color:#fff; border-radius:14px; padding:26px; display:flex; flex-direction:column; gap:18px;}
  .offer-stat-num{font-family:'DM Sans',sans-serif; font-weight:600; font-size:26px;}
  .offer-stat-label{font-size:11.5px; color:var(--orange); margin-top:2px;}
  .offer-stats .btn-secondary{margin-top:6px; text-align:center; justify-content:center;}

  /* Cas clients */
  .case-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:20px; margin-bottom:36px;}
  @media (max-width:640px){ .case-grid{grid-template-columns:1fr; gap:48px;} .case-wrap{padding-left:12px; padding-right:12px;} }
  .case-card{display:block;}
  .case-preview{position:relative; border-radius:36px; overflow:hidden; aspect-ratio:1/1; background:var(--slate); margin-bottom:16px;}
  @media (max-width:640px){ .case-preview{aspect-ratio:3/4; border-radius:28px;} }
  .case-preview img{transition:transform .5s cubic-bezier(.16,1,.3,1);}
  .case-preview video{position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0; transition:opacity .3s ease, transform .5s cubic-bezier(.16,1,.3,1);}
  .case-preview.hovering video{opacity:1;}
  .case-card:hover .case-preview img, .case-card:hover .case-preview video{transform:scale(1.06);}
  .case-tags{display:flex; gap:8px; margin-bottom:12px; flex-wrap:wrap;}
  .case-tag{font-size:11.5px; padding:5px 12px; border-radius:12px; background:var(--surface,#fff); border:1px solid var(--line); color:var(--ink);}
  .case-card h3{font-family:'DM Sans',sans-serif; font-weight:600; font-size:19px; margin-bottom:8px;}
  @media (max-width:640px){ .case-card h3{font-size:24px;} }
  .case-card p{color:var(--grey); font-size:14px; line-height:1.6; margin-bottom:12px;}
  @media (max-width:640px){ .case-card p{font-size:15.5px;} }
  .case-link{font-size:14px; font-weight:500; color:var(--ink); text-decoration:none; display:inline-flex; align-items:center; gap:10px;}
  .case-link-icon{display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; border-radius:9px; background:var(--orange); color:#fff; font-size:14px; flex-shrink:0; transition:transform .2s ease;}
  .case-card:hover .case-link-icon{transform:translateX(3px);}
  .case-more{text-align:center;}

  @media (max-width:760px){ .compare-visual-grid{grid-template-columns:1fr !important;} }

  /* FAQ accordion */
  .faq-item{border-top:1px solid var(--line);}
  .faq-item:last-child{border-bottom:1px solid var(--line);}
  .faq-q{width:100%; text-align:left; background:none; border:none; padding:22px 4px; font-family:'DM Sans',sans-serif; font-size:17px; font-weight:500; display:flex; justify-content:space-between; align-items:center; cursor:pointer; color:var(--ink);}
  .faq-q .chevron{transition:transform .25s ease; color:var(--orange);}
  .faq-item.open .faq-q .chevron{transform:rotate(45deg);}
  .faq-a{max-height:0; overflow:hidden; transition:max-height .3s ease;}
  .faq-a p{padding:0 4px 22px; color:var(--grey); font-size:15px; line-height:1.6; max-width:640px;}

  /* Ask IA — barre flottante fixe, toujours accessible */
  .ask-box{
    position:fixed; left:50%; bottom:48px; width:min(640px, calc(100% - 32px));
    transform:translateX(-50%) translateY(16px); opacity:0; pointer-events:none;
    border:1px solid var(--line); border-radius:14px; background:#fff; overflow:hidden;
    box-shadow:0 20px 44px -16px rgba(9,9,11,0.32); z-index:70;
    transition:opacity .3s ease, transform .3s ease;
  }
  .ask-box.visible{opacity:1; pointer-events:auto; transform:translateX(-50%) translateY(0);}
  .ask-chips{display:flex; gap:6px; flex-wrap:nowrap; overflow-x:auto; scroll-snap-type:x proximity; padding:10px 14px 0; max-width:100%; scrollbar-width:none;}
  .ask-chips::-webkit-scrollbar{display:none;}
  .ask-chip{font-size:11.5px; padding:7px 12px; border-radius:100px; border:1px solid var(--line); background:var(--paper); color:var(--ink); cursor:pointer; font-family:'DM Sans',sans-serif; transition:border-color .2s ease, color .2s ease; white-space:nowrap; flex-shrink:0; scroll-snap-align:start;}
  .ask-chip:hover{border-color:var(--orange); color:var(--orange);}
  .ask-answer:not(:empty){padding:10px 14px 0; font-size:13.5px; line-height:1.5; color:var(--ink); max-height:150px; overflow-y:auto;}
  .ask-answer.loading{color:var(--grey); font-style:italic;}
  .ask-answer.error{color:#dc2626;}
  .ask-form{display:flex; align-items:center; gap:10px; padding:10px 10px 10px 16px;}
  .ask-spark{color:var(--orange); font-size:16px; flex-shrink:0;}
  .ask-input{flex:1; min-width:0; border:none; outline:none; font-family:'DM Sans',sans-serif; font-size:14px; background:transparent; color:var(--ink);}
  .ask-input::placeholder{color:var(--grey);}
  .ask-submit{width:32px; height:32px; border-radius:50%; background:var(--ink); color:#fff; border:none; display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0; transition:background .2s ease;}
  .ask-submit:hover{background:var(--orange);}
  .ask-submit:disabled{opacity:0.5; cursor:not-allowed;}
  .ask-disclaimer{font-size:10.5px; color:var(--grey); text-align:center; padding:0 14px 10px;}
  @media (max-width:480px){ .ask-chips{display:none;} }

  /* Final CTA */
  .final-cta{background:var(--slate); color:var(--paper); text-align:center; padding:96px 0;}
  .final-cta h2{color:var(--paper); margin:0 auto 16px;}
  .final-cta p{color:rgba(244,244,245,0.7); max-width:440px; margin:0 auto 36px;}

  /* Footer — cinématique : fond encre, grille, halo, wordmark géant, marquee */
  footer{position:relative; overflow:hidden; background:var(--ink); color:var(--paper); padding:72px 0 32px; margin-top:40px;}
  .cine-grid{position:absolute; inset:0; z-index:0; pointer-events:none; background-size:56px 56px;
    background-image:linear-gradient(to right, rgba(244,244,245,.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(244,244,245,.05) 1px, transparent 1px);
    -webkit-mask-image:linear-gradient(to bottom, transparent, #000 25%); mask-image:linear-gradient(to bottom, transparent, #000 25%);}
  .cine-aurora{position:absolute; z-index:0; pointer-events:none; left:50%; top:-10%; width:60vw; height:60vw; max-width:640px; max-height:640px; transform:translateX(-50%);
    background:radial-gradient(circle, rgba(255,90,0,.28) 0%, rgba(255,90,0,.08) 45%, transparent 70%); filter:blur(50px); border-radius:50%;
    animation:cine-breathe 8s ease-in-out infinite alternate;}
  @keyframes cine-breathe{0%{transform:translateX(-50%) scale(1); opacity:.7;} 100%{transform:translateX(-50%) scale(1.15); opacity:1;}}
  .cine-giant{position:absolute; z-index:0; pointer-events:none; left:50%; bottom:-3.5vw; transform:translateX(-50%); white-space:nowrap; user-select:none;
    font-family:'DM Sans',sans-serif; font-weight:800; font-size:15vw; line-height:.8; letter-spacing:-0.03em; color:transparent;
    background:linear-gradient(180deg, rgba(244,244,245,.08) 0%, transparent 65%); -webkit-background-clip:text; background-clip:text;}
  .cine-marquee{position:relative; z-index:1; overflow:hidden; border-top:1px solid rgba(244,244,245,.12); border-bottom:1px solid rgba(244,244,245,.12); padding:14px 0; margin-bottom:56px;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent); mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);}
  .cine-marquee-track{display:flex; width:max-content; animation:scroll-left 30s linear infinite;}
  .cine-marquee-track span{display:flex; align-items:center; padding:0 18px; font-size:12.5px; font-weight:600; letter-spacing:.04em; text-transform:uppercase; color:rgba(244,244,245,.5); white-space:nowrap;}
  .cine-marquee-track span.dot{color:var(--orange); padding:0 2px;}
  .footer-content{position:relative; z-index:1;}
  .footer-top{display:flex; justify-content:space-between; gap:40px; flex-wrap:wrap; margin-bottom:48px;}
  .footer-desc{max-width:340px; color:rgba(244,244,245,.6); font-size:14px; line-height:1.6; margin-top:16px;}
  .footer-links{display:flex; gap:64px; flex-wrap:wrap;}
  .footer-col h4{font-size:12px; text-transform:uppercase; letter-spacing:0.04em; color:rgba(244,244,245,.4); margin-bottom:14px;}
  .footer-col a{display:block; font-size:14px; margin-bottom:10px; color:rgba(244,244,245,.85);}
  .footer-col a:hover{color:var(--orange);}
  .footer-villes{font-size:13px; color:rgba(244,244,245,.5); margin-top:32px;}
  .footer-villes a{color:rgba(244,244,245,.7);}
  .footer-bottom{border-top:1px solid rgba(244,244,245,.12); padding:24px 90px 0 0; margin-top:24px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; font-size:12.5px; color:rgba(244,244,245,.5); text-transform:uppercase; letter-spacing:0.03em;}
  .cine-credit{display:inline-flex; align-items:center; gap:8px; padding:9px 18px; border-radius:100px; background:rgba(244,244,245,.05); border:1px solid rgba(244,244,245,.12); backdrop-filter:blur(8px); text-transform:none;}
  .cine-heart{color:var(--orange); display:inline-block; animation:cine-heartbeat 2s ease-in-out infinite;}
  @keyframes cine-heartbeat{0%,100%{transform:scale(1);} 25%{transform:scale(1.3);} 40%{transform:scale(1);}}
  .cine-top{width:38px; height:38px; border-radius:50%; background:rgba(244,244,245,.05); border:1px solid rgba(244,244,245,.15); color:rgba(244,244,245,.7); display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all .3s cubic-bezier(.16,1,.3,1); flex-shrink:0;}
  .cine-top:hover{background:rgba(244,244,245,.12); color:#fff; transform:translateY(-3px);}
  .cine-reveal{opacity:0; transform:translateY(20px); transition:opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1);}
  .cine-reveal.in{opacity:1; transform:translateY(0);}
  @media (prefers-reduced-motion: reduce){.cine-aurora,.cine-heart{animation:none;} .cine-marquee-track{animation:none;} .cine-reveal{transition:none; opacity:1; transform:none;}}

  /* Cookie banner */
  .cookie-banner{
    position:fixed; left:20px; right:20px; bottom:20px; max-width:520px; margin:0 auto;
    background:var(--paper); border:1px solid var(--line); border-radius:14px; padding:22px 24px;
    box-shadow:0 12px 40px -12px rgba(9,9,11,0.25); z-index:1000; display:none;
  }
  .cookie-banner p{font-size:13.5px; line-height:1.6; color:var(--ink); margin-bottom:16px;}
  .cookie-banner p a{color:var(--orange); text-decoration:underline;}
  .cookie-banner .cookie-actions{display:flex; gap:10px;}
  .cookie-banner .cookie-actions button{flex:1; font-size:13.5px; padding:11px 16px; border-radius:12px; cursor:pointer; font-family:'DM Sans',sans-serif;}
  .cookie-banner .btn-refuse{background:transparent; border:1px solid var(--line); color:var(--ink);}
  .cookie-banner .btn-accept{background:var(--ink); border:none; color:#fff;}

  .burger{display:none; background:none; border:none; cursor:pointer; width:40px; height:40px; padding:10px; flex-direction:column; justify-content:center; gap:6px;}
  .burger span{display:block; height:1.5px; background:var(--ink); transition:transform .25s ease, opacity .25s ease;}
