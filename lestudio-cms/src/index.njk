<script>
  var cases = {{ collections.homeCases | casesJson | safe }};

  function caseFallback(name){
    var initials = (name || '').split(' ').map(function(w){ return w[0]; }).join('').slice(0, 2).toUpperCase();
    return '<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,rgba(255,107,53,0.18),rgba(244,244,245,0.06));">' +
      '<span style="font-family:\'DM Sans\',sans-serif;font-weight:600;font-size:30px;letter-spacing:0.02em;color:rgba(244,244,245,0.75);">' + initials + '</span>' +
      '</div>';
  }

  function caseVisual(c){
    if(c.cover){
      return '<img src="' + c.cover + '" alt="' + c.name + '" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">';
    }
    return caseFallback(c.name);
  }

  var caseGrid = document.getElementById('caseGrid');
  if(caseGrid){
    caseGrid.innerHTML = cases.map(function(c){
      return '<a class="case-card" href="/realisations/' + c.slug + '/">' +
        '<div class="case-preview">' +
          caseVisual(c) +
          (c.video ? '<video muted loop playsinline preload="none" onerror="this.style.display=\'none\'"><source src="' + c.video + '" type="video/mp4"></video>' : '') +
        '</div>' +
        '<div class="case-tags"><span class="case-tag">' + c.tag1 + '</span><span class="case-tag">' + c.tag2 + '</span></div>' +
        '<h3>' + c.name + '</h3>' +
        '<p>' + c.desc + '</p>' +
        '<span class="case-link"><span class="case-link-icon">→</span> Voir le projet</span>' +
      '</a>';
    }).join('');

    caseGrid.querySelectorAll('.case-preview').forEach(function(preview){
      var video = preview.querySelector('video');
      if(!video) return;
      preview.addEventListener('mouseenter', function(){
        preview.classList.add('hovering');
        video.play().catch(function(){});
      });
      preview.addEventListener('mouseleave', function(){
        preview.classList.remove('hovering');
        video.pause();
        video.currentTime = 0;
      });
    });
  }
</script>

