<script>
  var testimonials = {{ collections.temoignages | temoignagesJson | safe }};
  var tActive = 0;
  var tTabs = document.getElementById('t-tabs');
  function renderTesti(){
    var t = testimonials[tActive];
    var isVideo = t.type === 'video';
    var hasQuote = !!t.quote;
    document.getElementById('t-quote').style.display = hasQuote ? 'block' : 'none';
    var vBox = document.getElementById('t-video');
    vBox.style.display = isVideo ? 'flex' : 'none';
    document.getElementById('t-avatar').style.display = isVideo ? 'none' : 'flex';
    if(isVideo && t.video){
      vBox.innerHTML = '<video controls playsinline preload="metadata" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;"><source src="' + t.video + '" type="video/mp4"></video>';
    }
    if(hasQuote){
      document.getElementById('t-quote').innerHTML = t.quote;
    }
    if(!isVideo){
      var avatarEl = document.getElementById('t-avatar');
      avatarEl.innerHTML = t.photo ? '<img src="' + t.photo + '" alt="' + t.name + '" loading="lazy">' : '';
      if(!t.photo) avatarEl.textContent = t.initials;
    }
    document.getElementById('t-name').textContent = t.name;
    document.getElementById('t-role').textContent = t.role;
    Array.from(tTabs.children).forEach(function(btn, i){ btn.classList.toggle('active', i === tActive); });
  }
  testimonials.forEach(function(t, i){
    var btn = document.createElement('button');
    btn.textContent = t.client;
    btn.onclick = function(){ tActive = i; renderTesti(); };
    tTabs.appendChild(btn);
  });
  renderTesti();

  var faqs = {{ collections.faq | faqJson | safe }};
  var faqList = document.getElementById('faq-list');
  faqs.forEach(function(f){
    var item = document.createElement('div');
    item.className = 'faq-item';
    item.innerHTML = '<button class="faq-q">' + f.q + '<svg width="20" height="20" viewBox="0 0 24 24" class="chevron"><path fill="currentColor" d="M12.75 9a.75.75 0 0 0-1.5 0v2.25H9a.75.75 0 0 0 0 1.5h2.25V15a.75.75 0 0 0 1.5 0v-2.25H15a.75.75 0 0 0 0-1.5h-2.25z"/><path fill="currentColor" fill-rule="evenodd" d="M12 1.25C6.063 1.25 1.25 6.063 1.25 12S6.063 22.75 12 22.75S22.75 17.937 22.75 12S17.937 1.25 12 1.25M2.75 12a9.25 9.25 0 1 1 18.5 0a9.25 9.25 0 0 1-18.5 0" clip-rule="evenodd"/></svg></button><div class="faq-a"><p>' + f.a + '</p></div>';
    var btn = item.querySelector('.faq-q');
    var panel = item.querySelector('.faq-a');
    btn.onclick = function(){
      var isOpen = item.classList.contains('open');
      faqList.querySelectorAll('.faq-item').forEach(function(el){ el.classList.remove('open'); el.querySelector('.faq-a').style.maxHeight = null; });
      if(!isOpen){ item.classList.add('open'); panel.style.maxHeight = panel.scrollHeight + 'px'; }
    };
    faqList.appendChild(item);
  });
</script>
<script>
  (function(){
    var scrollMain = document.getElementById('scrollMain');
    var railFill = document.getElementById('railFill');
    var sideNum = document.getElementById('sideNum');
    var sideDuration = document.getElementById('sideDuration');
    if(!scrollMain) return;
    var blocks = scrollMain.querySelectorAll('.scroll-block');
    function update(){
      var rect = scrollMain.getBoundingClientRect();
      var total = rect.height - window.innerHeight * 0.5;
      var scrolled = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
      var pct = total > 0 ? (scrolled / total) * 100 : 0;
      railFill.style.height = pct + '%';

      var mid = window.innerHeight * 0.4;
      var current = blocks[0];
      blocks.forEach(function(b){
        var r = b.getBoundingClientRect();
        if (r.top < mid) current = b;
        b.classList.remove('active');
      });
      current.classList.add('active');
      sideNum.textContent = current.getAttribute('data-num');
      sideDuration.textContent = current.getAttribute('data-duration');
    }
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

