  }
  .mobile-menu-cta-icon{
    width:34px; height:34px; border-radius:9px; background:var(--ink); color:#fff;
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
  }
  .btn-outline{background:transparent !important; border-color:var(--line) !important; color:var(--ink) !important;}
  .btn-outline::before, .btn-outline::after{display:none !important;}
  .btn-outline{animation:none !important;}

  /* ── Anti-metal CTA : pill sombre, accent orange qui se déploie au survol ── */
  .btn-anti{
    position:relative !important; display:inline-flex !important; align-items:center !important;
    justify-content:flex-start !important; align-self:flex-start !important;
    width:max-content !important; max-width:100% !important; flex:none !important;
    overflow:hidden; isolation:isolate; cursor:pointer;
    height:44px !important; padding:0 18px 0 48px !important; border-radius:12px !important; border:none !important;
    background:var(--ink) !important;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.08), 0 4px 12px rgba(0,0,0,.18);
    transition:transform .15s ease;
  }
  .btn-anti:active{transform:scale(0.98);}
  .btn-anti .anti-label{
    position:relative; z-index:1; display:block; color:#fff !important; font-size:14px; font-weight:500;
    letter-spacing:-0.01em; white-space:nowrap; font-family:'DM Sans',sans-serif;
  }
  .btn-anti .anti-accent{
    position:absolute; left:4px; top:4px; bottom:4px; z-index:10;
    display:flex; align-items:center; gap:2px; width:36px; padding-left:10px;
    border-radius:8px; overflow:hidden;
    background:linear-gradient(180deg,var(--orange-light) 0%,var(--orange) 100%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.4), inset 0 -2px 4px rgba(0,0,0,.12), 0 2px 4px rgba(0,0,0,.08);
    transition:width .2s cubic-bezier(.65,0,.35,1);
  }
  .btn-anti:is(:hover, :focus-visible) .anti-accent{width:calc(100% - 8px);}
  .anti-arrow{flex-shrink:0; animation:anti-arrow-slide 1.2s ease-in-out infinite;}
  @keyframes anti-arrow-slide{0%, 100%{opacity:.4; transform:translateX(0);} 50%{opacity:1; transform:translateX(2px);}}
  @media (prefers-reduced-motion: reduce){.anti-arrow{animation:none; opacity:1;} .btn-anti .anti-accent{transition:none;}}

  /* ── Anti-metal secondary : version discrète, sans accent ni animation ── */
  .btn-anti-secondary{
    display:inline-flex !important; align-items:center !important; justify-content:center !important;
    width:max-content !important; max-width:100% !important; flex:none !important; align-self:flex-start !important;
    height:auto !important; padding:12px 22px !important; border-radius:10px !important;
