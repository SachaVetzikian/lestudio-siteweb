<script>
(function(){
  var form = document.getElementById('askForm');
  var input = document.getElementById('askInput');
  var submitBtn = document.getElementById('askSubmit');
  var answerBox = document.getElementById('askAnswer');
  var chips = document.getElementById('askChips');
  if(!form || !input) return;

  function setLoading(isLoading){
    input.disabled = isLoading;
    submitBtn.disabled = isLoading;
  }

  function showAnswer(text, kind){
    answerBox.textContent = text;
    answerBox.className = 'ask-answer' + (kind ? ' ' + kind : '');
  }

  function ask(question){
    question = (question || '').trim();
    if(!question) return;
    input.value = question;
    setLoading(true);
    showAnswer('LeStudio réfléchit…', 'loading');
    fetch('/api/ask', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ question: question })
    }).then(function(res){
      return res.json().then(function(data){ return { ok: res.ok, data: data }; });
    }).then(function(result){
      if(result.ok && result.data.answer){
        showAnswer(result.data.answer, '');
      } else {
        showAnswer((result.data && result.data.message) || "Réponse indisponible pour le moment. Réservez plutôt un appel découverte.", 'error');
      }
    }).catch(function(){
      showAnswer("Réponse indisponible pour le moment. Réservez plutôt un appel découverte.", 'error');
    }).finally(function(){
      setLoading(false);
    });
  }

  form.addEventListener('submit', function(e){
    e.preventDefault();
    ask(input.value);
  });

  if(chips){
    chips.querySelectorAll('.ask-chip').forEach(function(chip){
      chip.addEventListener('click', function(){ ask(chip.textContent); });
    });
  }

  var askBox = document.getElementById('askBox');
  if(askBox){
    var toggleAskBox = function(){
      askBox.classList.toggle('visible', window.scrollY > window.innerHeight * 0.6);
    };
    window.addEventListener('scroll', toggleAskBox, { passive: true });
    toggleAskBox();
  }
})();
</script>
<script>
  (function(){
    var scrollMain = document.getElementById('scrollMain');
    var railFill = document.getElementById('railFill');
    var sideNum = document.getElementById('sideNum');
    if(!scrollMain) return;
    var blocks = scrollMain.querySelectorAll('.scroll-block');
    function update(){
      var rect = scrollMain.getBoundingClientRect();
      var total = rect.height - window.innerHeight * 0.5;
      var scrolled = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
      var pct = total > 0 ? (scrolled / total) * 100 : 0;
      railFill.style.height = pct + '%';

      var mid = window.innerHeight * 0.4;
      var current = blocks[0];
      blocks.forEach(function(b){
        var r = b.getBoundingClientRect();
        if (r.top < mid) current = b;
        b.classList.remove('active');
      });
      current.classList.add('active');
      sideNum.textContent = current.getAttribute('data-num');
    }
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

