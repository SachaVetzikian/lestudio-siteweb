---
layout: layouts/base.njk
---
{% set crumbs = [ {name:"Accueil", url:"/"}, {name: h1} ] %}
{% include "partials/breadcrumb.njk" %}
<h1 style="margin-top:16px;">{{ h1 }}</h1>
<p class="lede">{{ intro }}</p>
<a class="btn-primary" style="margin:0 0 48px;" href="{{ settings.rdv }}" target="_blank" rel="noopener" data-cal-namespace="20min" data-cal-link="sacha-vetzikian/20min"><img alt="Sacha Vetzikian, fondateur de LeStudio" class="avatar avatar-inline" height="36" loading="lazy" src="/sacha-avatar.webp" width="36"/><span>Prendre rendez-vous avec Sacha</span></a>

<div class="asset-mock-wrap">
<div class="asset-mock-card">
<div class="am-chrome">
<div class="am-dots"><span></span><span></span><span></span></div>
<div class="am-label"><svg width="10" height="10" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M23 7l-7 5 7 5V7z"/><path fill="none" stroke="currentColor" stroke-width="2" d="M14 5H3a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2z"/></svg>Studio ↔ {{ title }}</div>
</div>
<div class="am-body">
<div class="am-avatar-row">
<span class="am-avatar-circle" style="background:var(--orange);">SV</span>
<span class="am-avatar-circle" style="background:var(--ink);">{{ title | truncate(2, false, "") | upper }}</span>
</div>
<div class="am-req"><svg width="14" height="14" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke="var(--orange)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Rendez-vous en visio, à vos disponibilités</span></div>
<div class="am-req"><svg width="14" height="14" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke="var(--orange)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Restitutions enregistrées pour vos équipes</span></div>
<div class="am-req pending"><span class="am-req-dot"></span><span>Un seul interlocuteur, du brief à la livraison</span></div>
</div>
</div>
</div>

{% include "partials/trust-marquee.njk" %}

{% if points %}
<h2>Ce que ça change pour votre projet</h2>
<div class="ville-point-grid">
{% for p in points %}
<div class="ville-point-card">
<span class="feature-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.5-7-11.5A7 7 0 0 1 19 9.5C19 14.5 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
<h3>{{ p.titre }}</h3>
<p>{{ p.texte }}</p>
</div>
{% endfor %}
</div>
{% endif %}

<h2>Nos réalisations</h2>
<div class="case-grid">
{% set shown = 0 %}
{% for r in collections.realisations %}
{% if r.data.featured and shown < 3 %}
{% set shown = shown + 1 %}
<a class="case-card" href="/realisations/{{ r.fileSlug }}/">
{% if r.data.cover and (r.data.cover | assetExists) %}
<div class="case-preview">
<div class="case-browser-bar"><span class="case-browser-dot red"></span><span class="case-browser-dot yellow"></span><span class="case-browser-dot green"></span><span class="case-browser-url"></span></div>
<div class="case-shot"><img src="{{ r.data.cover }}" alt="{{ r.data.client }}" loading="lazy"/></div>
</div>
{% endif %}
<span class="case-badge">{% if r.data.type == "ecommerce" %}E-commerce{% else %}Vitrine{% endif %} · {{ r.data.tags[0] }}</span>
<h3>{{ r.data.client }}</h3>
<p>{{ r.data.description }}</p>
<div class="case-divider"></div>
<span class="case-link">Voir le projet →</span>
</a>
{% endif %}
{% endfor %}
</div>

{{ content | safe }}

{% if collections.temoignages.length %}
<h2>Ils en parlent mieux que nous</h2>
<div class="testi-grid">
{% set tShown = 0 %}
{% for t in collections.temoignages %}
{% if tShown < 2 %}
{% set tShown = tShown + 1 %}
<div class="testi-card">
<p class="testi-quote">{{ t.data.quote | mdInline | safe }}</p>
<p class="testi-author">{{ t.data.name }}<span>{{ t.data.role }}</span></p>
</div>
{% endif %}
{% endfor %}
</div>
{% endif %}

<a class="btn-primary" href="{{ settings.rdv }}" target="_blank" rel="noopener" data-cal-namespace="20min" data-cal-link="sacha-vetzikian/20min"><img alt="Sacha Vetzikian, fondateur de LeStudio" class="avatar avatar-inline" height="36" loading="lazy" src="/sacha-avatar.webp" width="36"/><span>Prendre rendez-vous avec Sacha</span></a>

{% include "partials/form-contact.njk" %}

<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"BreadcrumbList",
 "itemListElement":[
  {"@type":"ListItem","position":1,"name":"Accueil","item":"https://www.lestudiodesign.fr/"},
  {"@type":"ListItem","position":2,"name":{{ h1 | dump | safe }},"item":"https://www.lestudiodesign.fr{{ page.url }}"}
 ]
}
</script>

<style>
.ville-point-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:64px;}
@media (max-width:800px){.ville-point-grid{grid-template-columns:1fr;}}
.ville-point-card{border:1px solid var(--line);border-radius:20px;padding:26px;background:#fff;}
.ville-point-card .feature-icon{margin-bottom:14px;}
.ville-point-card h3{font-size:17px;margin-bottom:8px;text-transform:none;}
.ville-point-card p{font-size:14.5px;line-height:1.6;color:var(--grey);}
.feature-icon{display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:9px;background:var(--orange-light);color:var(--orange);flex-shrink:0;}
.testi-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:64px;}
@media (max-width:760px){.testi-grid{grid-template-columns:1fr;}}
.testi-card{border:1px solid var(--line);border-radius:20px;padding:26px;background:#fff;}
.testi-quote{font-size:15px;line-height:1.65;color:var(--ink);margin-bottom:16px;}
.testi-author{font-family:'DM Sans',sans-serif;font-weight:600;font-size:14px;color:var(--ink);}
.testi-author span{display:block;font-family:'DM Sans',sans-serif;font-weight:400;font-size:13px;color:var(--grey);margin-top:2px;}
</style>
