---
layout: layouts/base.njk
---
{% set crumbs = [ {name:"Accueil", url:"/"}, {name: h1} ] %}
{% include "partials/breadcrumb.njk" %}
<h1 style="margin-top:16px;">{{ h1 }}</h1>
<p class="lede">{{ intro }}</p>
<a class="link-cta" style="margin:0 0 48px;" href="{{ settings.rdv }}" target="_blank" rel="noopener" data-cal-namespace="20min" data-cal-link="sacha-vetzikian/20min">Prendre rendez-vous avec Sacha<span class="arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></span></a>

{% include "partials/trust-marquee.njk" %}

{% if points %}
<h2>Ce que ça change pour votre projet</h2>
<div class="ville-point-grid">
{% for p in points %}
<div class="ville-point-card">
<span class="feature-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.5-7-11.5A7 7 0 0 1 19 9.5C19 14.5 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
<h3>{{ p.titre }}</h3>
<p>{{ p.texte }}</p>
</div>
{% endfor %}
</div>
{% endif %}

<h2>Nos réalisations</h2>
<div class="case-list" style="margin-top:8px;">
{% set shown = 0 %}
{% for r in collections.realisations %}
{% if r.data.featured and shown < 3 %}
{% set shown = shown + 1 %}
<a class="case-row" href="/realisations/{{ r.fileSlug }}/">
<span class="case-row-year">{{ r.data.year }}</span>
<div class="case-row-title"><h3>{{ r.data.client }}</h3><div class="case-row-meta"><span>{{ r.data.description }}</span></div></div>
{% if r.data.cover and (r.data.cover | assetExists) %}<div class="case-row-thumb"><img src="{{ r.data.cover }}" alt="{{ r.data.client }}" loading="lazy"/></div>{% endif %}
<span class="case-row-arrow"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></span>
</a>
{% endif %}
{% endfor %}
</div>

{{ content | safe }}

<a class="link-cta" href="{{ settings.rdv }}" target="_blank" rel="noopener" data-cal-namespace="20min" data-cal-link="sacha-vetzikian/20min">Prendre rendez-vous avec Sacha<span class="arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></span></a>

{% include "partials/form-contact.njk" %}

<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"BreadcrumbList",
 "itemListElement":[
  {"@type":"ListItem","position":1,"name":"Accueil","item":"https://www.lestudiodesign.fr/"},
  {"@type":"ListItem","position":2,"name":{{ h1 | dump | safe }},"item":"https://www.lestudiodesign.fr{{ page.url }}"}
 ]
}
</script>

<style>
.ville-point-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:64px;}
@media (max-width:800px){.ville-point-grid{grid-template-columns:1fr;}}
.ville-point-card{border:1px solid var(--line);border-radius:4px;padding:26px;background:#fff;}
.ville-point-card .feature-icon{margin-bottom:14px;}
.ville-point-card h3{font-size:17px;margin-bottom:8px;text-transform:none;}
.ville-point-card p{font-size:14.5px;line-height:1.6;color:var(--ink-60);}
.feature-icon{display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;border:1px solid var(--line);color:var(--ink);flex-shrink:0;}
</style>
