{% if collections.villes.length %}<p>Villes : {% for v in collections.villes %}<a href="/designer-ux-ui/{{ v.fileSlug }}/">{{ v.data.title }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
<div class="footer-bottom">
<span>Design et UX par LeStudio</span>
<span class="cine-credit"><span class="cine-heart">❤</span> Conçu avec passion par LeStudio</span>
<button class="cine-top" id="footerToTop" aria-label="Retour en haut" type="button">
<svg width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>
</button>
</div>
</div>
</footer>
<script>
(function(){
  var reveal = document.getElementById('footerReveal');
  if(reveal && 'IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ reveal.classList.add('in'); io.disconnect(); } });
    }, { threshold: 0.15 });
    io.observe(reveal);
  } else if(reveal){ reveal.classList.add('in'); }
  var toTop = document.getElementById('footerToTop');
  if(toTop) toTop.addEventListener('click', function(){ window.scrollTo({ top: 0, behavior: 'smooth' }); });
})();
</script>

