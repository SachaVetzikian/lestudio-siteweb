{% if collections.secteurs.length %}<p>Secteurs : {% for s in collections.secteurs %}<a href="/secteur/{{ s.fileSlug }}/">{{ s.data.title }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
{% if collections.villes.length %}<p>Villes : {% for v in collections.villes %}<a href="/designer-ux-ui/{{ v.fileSlug }}/">{{ v.data.title }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
</div></footer>

