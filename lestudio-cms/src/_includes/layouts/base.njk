<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>{% if seo_title %}{{ seo_title | safe }}{% else %}{{ title | safe }} · LeStudio{% endif %}</title>
<meta name="description" content="{{ (seo_description or description) | safe }}"/>
<link href="/static/favicon.svg" rel="icon" type="image/svg+xml"/>
<link href="/static/favicon-32.png" rel="icon" type="image/png" sizes="32x32"/>
<link href="/static/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180"/>
<link rel="canonical" href="https://www.lestudiodesign.fr{{ page.url }}"/>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600&family=Instrument+Serif:ital,wght@1,400&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet"/>
<style>
:root{--ink:#141413;--paper:#F5F3EF;--orange:#FD5C04;--orange-light:#FFE3D2;--grey:#615D72;--line:rgba(20,20,19,0.12);}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'DM Sans',sans-serif;background:var(--paper);color:var(--ink);-webkit-font-smoothing:antialiased;}
a{color:inherit;text-decoration:none;}
.wrap{max-width:1100px;margin:0 auto;padding:0 32px;}
header.nav{position:sticky;top:0;z-index:100;background:rgba(245,243,239,0.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--line);}
.nav-inner{max-width:1100px;margin:0 auto;padding:20px 32px;display:flex;align-items:center;justify-content:space-between;}
.logo{font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:600;}
.nav-cta{font-size:13.5px;font-weight:500;background:var(--orange);color:var(--ink);padding:11px 20px;border-radius:100px;}
h1{font-family:'Space Grotesk',sans-serif;font-weight:600;line-height:1.1;letter-spacing:-0.02em;font-size:clamp(34px,4.5vw,54px);margin:80px 0 24px;}
h1 em{font-family:'Instrument Serif',serif;font-style:italic;font-weight:400;color:var(--orange);}
h2{font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:clamp(24px,3vw,34px);margin:64px 0 20px;}
.lede{font-size:19px;line-height:1.6;color:var(--grey);max-width:640px;margin-bottom:40px;}
.card{border:1px solid var(--line);border-radius:14px;padding:28px;background:#fff;margin-bottom:20px;}
.card h3{font-family:'Space Grotesk',sans-serif;font-size:18px;margin-bottom:8px;}
.card p{font-size:15px;line-height:1.6;color:var(--grey);}
.case-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px;margin:32px 0 64px;}
.btn-primary{display:inline-flex;align-items:center;gap:10px;background:var(--orange);color:var(--ink);border-radius:100px;padding:14px 26px;font-weight:500;margin:24px 0 80px;}
footer{border-top:1px solid var(--line);padding:40px 0;margin-top:40px;font-size:14px;color:var(--grey);}
.nav-links-b{display:flex;gap:22px;font-size:14px;font-weight:500;}
.nav-links-b a:hover{color:var(--orange);}
@media (max-width:860px){.nav-links-b{display:none;}}
</style>

<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"ProfessionalService",
 "name":"LeStudio","url":"https://www.lestudiodesign.fr",
 "description":"Studio de design UX/UI & CRO pour sites e-commerce et vitrines.",
 "email":"{{ settings.email }}","telephone":"{{ settings.telephone }}",
 "areaServed":"FR",
 "sameAs":["{{ settings.linkedin }}","{{ settings.instagram }}","{{ settings.twitter }}"]
}
</script>
</head>
<body>
<header class="nav"><div class="nav-inner">
<a class="logo" href="/">LeStudio</a>
<nav class="nav-links-b">
<a href="/offres/audit-ux-ui-cro/">Audit</a>
<a href="/offres/creation-refonte-site/">Création / Refonte</a>
<a href="/offres/design-abonnement/">Abonnement</a>
<a href="/cas-clients/">Cas clients</a>
</nav>
<a class="nav-cta" href="{{ settings.rdv }}" target="_blank" rel="noopener">Réserver un appel découverte ›</a>
</div></header>
<main class="wrap">
{{ content | safe }}
</main>
<footer><div class="wrap" style="display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:center;">
<p>© 2026 LeStudio · <a href="mailto:{{ settings.email }}">{{ settings.email }}</a></p>
<p><a href="/offres/audit-ux-ui-cro/">Audit UX/UI & CRO</a> · <a href="/offres/creation-refonte-site/">Création / Refonte</a> · <a href="/offres/design-abonnement/">Design par abonnement</a> · <a href="/cas-clients/">Cas clients</a> · <a href="/mentions-legales/">Mentions légales</a></p>
</div></footer>

<a class="wa-float" href="{{ settings.whatsapp }}?text=Bonjour%2C%20je%20vous%20contacte%20depuis%20lestudiodesign.fr.%20J%27aimerais%20plus%20d%27informations." target="_blank" rel="noopener" aria-label="Nous écrire sur WhatsApp">
<svg viewBox="0 0 32 32" width="30" height="30" fill="#fff" aria-hidden="true"><path d="M16 3C9.4 3 4 8.3 4 14.9c0 2.6.8 5 2.3 7L4.6 28l6.3-1.6c1.9 1 4 1.6 5.1 1.6 6.6 0 12-5.3 12-11.9S22.6 3 16 3zm0 21.8c-1 0-3-.5-4.7-1.5l-.3-.2-3.7 1 1-3.6-.2-.4c-1.3-1.7-2-3.8-2-5.9C6.1 9.4 10.5 5 16 5s9.9 4.4 9.9 9.9-4.4 9.9-9.9 9.9zm5.4-7.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.7-1.7-1-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.6-.3z"/></svg>
</a>
<style>
.wa-float{position:fixed;bottom:22px;right:22px;z-index:98;width:56px;height:56px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 24px -8px rgba(20,20,19,0.4);transition:transform .2s;}
.wa-float:hover{transform:scale(1.08);}
</style>
</body>
</html>
