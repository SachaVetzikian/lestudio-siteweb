<style>
:root{--ink:#09090b;--slate:#27272a;--paper:#f4f4f5;--orange:#ff5a00;--orange-light:#ffe4d6;--grey:#3f3f46;--line:#ececee;}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'DM Sans',sans-serif;background:var(--paper);color:var(--ink);-webkit-font-smoothing:antialiased;}
a{color:inherit;text-decoration:none;}
.wrap{max-width:1100px;margin:0 auto;padding:0 32px;}
header.nav{position:sticky;top:0;z-index:100;background:rgba(244,244,245,0.75);backdrop-filter:blur(14px);border-bottom:1px solid var(--line);transition:background .3s ease,box-shadow .3s ease;}
header.nav.scrolled{background:rgba(244,244,245,0.94);box-shadow:0 6px 24px -12px rgba(20,18,31,0.2);}
.nav-inner{width:100%;box-sizing:border-box;padding:20px 32px;display:flex;align-items:center;justify-content:space-between;}
@media (max-width:480px){.nav-inner{padding:16px 16px;}}
.logo{font-family:'DM Sans',sans-serif;font-size:20px;font-weight:600;display:flex;align-items:center;gap:8px;}
.nav-cta{font-size:13.5px;font-weight:400;background:var(--ink);color:#fff;padding:11px 20px;border-radius:100px;}
.nav-cta .nav-cta-short{display:none;}
@media (max-width:480px){
  .logo svg{width:100px;height:auto;}
  .nav-cta{padding:9px 14px;}
  .nav-cta .nav-cta-full{display:none;}
  .nav-cta .nav-cta-short{display:inline-flex;}
}
h1{font-family:'DM Sans',sans-serif;font-weight:600;line-height:1.15;letter-spacing:-0.02em;font-size:clamp(34px,4.8vw,60px);margin:80px 0 24px;}
h1 em{font-style:normal;font-weight:600;color:var(--orange);}
h2{font-family:'DM Sans',sans-serif;font-weight:600;font-size:clamp(24px,3vw,36px);margin:64px 0 20px;}
.lede{font-size:18px;line-height:1.6;color:var(--grey);max-width:640px;margin-bottom:40px;}
.card{border:1px solid var(--line);border-radius:36px;padding:28px;background:#fff;margin-bottom:20px;}
.card h3{font-family:'DM Sans',sans-serif;font-size:18px;margin-bottom:8px;}
.card p{font-size:15px;line-height:1.6;color:var(--grey);}
.case-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px;margin:32px 0 64px;}
@media (max-width:800px){ .offre-qualif, .offre-inclus{grid-template-columns:1fr !important;} .offre-step{grid-template-columns:1fr !important;gap:6px !important;} }
.case-card{display:block;}
.case-preview{position:relative;border-radius:36px;overflow:hidden;aspect-ratio:1/1;background:var(--slate);margin-bottom:16px;}
@media (max-width:640px){.case-preview{aspect-ratio:3/4;border-radius:28px;}}
.case-preview img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .5s cubic-bezier(.16,1,.3,1);}
.case-card:hover .case-preview img{transform:scale(1.06);}
.case-tags{display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap;}
.case-tag{font-size:11.5px;padding:5px 12px;border-radius:12px;background:#fff;border:1px solid var(--line);color:var(--ink);}
.filter-tabs{display:flex;gap:10px;flex-wrap:wrap;margin:8px 0 32px;}
@media (max-width:640px){.filter-tabs{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:6px;}}
.filter-tab{font-family:'DM Sans',sans-serif;font-size:14px;font-weight:500;padding:10px 18px;border-radius:999px;background:#fff;border:1px solid var(--line);color:var(--ink);cursor:pointer;white-space:nowrap;flex-shrink:0;transition:background .2s ease,color .2s ease,border-color .2s ease;}
.filter-tab:hover{border-color:var(--ink);}
.filter-tab.active{background:var(--ink);color:#fff;border-color:var(--ink);}
.case-card h3{font-family:'DM Sans',sans-serif;font-weight:600;font-size:19px;margin-bottom:8px;}
.case-card p{color:var(--grey);font-size:14px;line-height:1.6;margin-bottom:12px;}
.case-link{font-size:14px;font-weight:500;color:var(--ink);text-decoration:none;display:inline-flex;align-items:center;gap:10px;}
.case-link-icon{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:9px;background:var(--orange);color:#fff;font-size:14px;flex-shrink:0;transition:transform .2s ease;}
.case-card:hover .case-link-icon{transform:translateX(3px);}
.btn-primary{display:inline-flex;align-items:center;gap:10px;background:var(--ink);color:#fff;border-radius:14px;padding:14px 26px;font-weight:400;margin:24px 0 80px;}
footer{border-top:1px solid var(--line);padding:40px 0;margin-top:40px;font-size:14px;color:var(--grey);}
.nav-links{display:flex;align-items:center;gap:36px;font-size:14px;font-weight:500;}
@media (max-width:860px){.nav-links{display:none;}}
.nav-dropdown{position:relative;}
.nav-dropdown-toggle{display:inline-flex;align-items:center;gap:6px;background:none;border:none;font:inherit;color:inherit;cursor:pointer;padding:0;}
.nav-dropdown-toggle svg{transition:transform .2s ease;}
.nav-dropdown:hover .nav-dropdown-toggle svg,.nav-dropdown.open .nav-dropdown-toggle svg{transform:rotate(180deg);}
.nav-dropdown-menu{position:absolute;top:100%;left:50%;transform:translateX(-50%);padding-top:14px;display:none;z-index:110;}
.nav-dropdown:hover .nav-dropdown-menu,.nav-dropdown.open .nav-dropdown-menu{display:block;}
.nav-dropdown-menu-inner{
  background:#fff;border:1px solid var(--line);border-radius:14px;padding:8px;
  box-shadow:0 20px 40px -20px rgba(9,9,11,0.25);display:flex;flex-direction:column;min-width:210px;
}
.nav-dropdown-menu-inner a{padding:10px 14px;border-radius:8px;font-size:14px;font-weight:500;white-space:nowrap;display:block;margin-bottom:0;}
.nav-dropdown-menu-inner a:hover{background:var(--paper);color:var(--orange);}

.burger{display:none;background:none;border:none;cursor:pointer;width:40px;height:40px;padding:10px;flex-direction:column;justify-content:center;gap:6px;}
.burger span{display:block;height:1.5px;background:var(--ink);transition:transform .25s ease,opacity .25s ease;}
.burger.open span:first-child{transform:translateY(3.75px) rotate(45deg);}
.burger.open span:last-child{transform:translateY(-3.75px) rotate(-45deg);}
@media (max-width:860px){.burger{display:flex;}}
header.nav.menu-open{background:var(--ink) !important;border-bottom-color:transparent;box-shadow:none;}
header.nav.menu-open .logo{color:#fff;}
header.nav.menu-open .burger span{background:#fff;}
header.nav.menu-open .nav-cta{display:none;}
.mobile-menu{display:none;position:fixed;top:0;right:0;bottom:0;width:75%;z-index:90;background:rgba(9,9,11,0.82);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);flex-direction:column;justify-content:center;padding:96px 28px 40px;overflow-y:auto;}
.mobile-menu.open{display:flex;}
.mobile-menu-inner{display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;justify-content:center;gap:6px 18px;margin:auto 0;}
.mobile-menu-item{width:auto;}
.mobile-menu-link,.mobile-menu-toggle{
  font-family:'DM Sans',sans-serif;font-size:17px;font-weight:500;color:var(--paper);
  padding:8px 2px;background:none;border:none;width:auto;text-align:center;
  display:flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;white-space:nowrap;
}
.mobile-menu-toggle svg{transition:transform .25s ease;flex-shrink:0;}
.mobile-menu-item.open .mobile-menu-toggle svg{transform:rotate(180deg);}
.mobile-submenu{display:none;flex-direction:column;gap:0;padding-bottom:10px;width:100%;}
.mobile-menu-item.open .mobile-submenu{display:flex;}
.mobile-submenu a{display:block;font-size:15px;font-weight:400;color:rgba(244,244,245,0.6);padding:8px 0;text-align:center;}
.mobile-submenu a:hover{color:var(--orange);}
.mobile-menu-footer{display:flex;justify-content:center;padding-top:28px;width:100%;}
.mobile-menu-cta{
  display:inline-flex;align-items:center;gap:12px;background:var(--orange);color:#fff;
  border-radius:100px;padding:8px 26px 8px 8px;font-family:'DM Sans',sans-serif;font-weight:600;font-size:16px;
}
.mobile-menu-cta-icon{
  width:34px;height:34px;border-radius:9px;background:var(--ink);color:#fff;
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.btn-outline{background:transparent !important;border-color:var(--line) !important;color:var(--ink) !important;}
.btn-outline::before,.btn-outline::after{display:none !important;}
.btn-outline{animation:none !important;}

/* ── Shiny CTA : bordure animée en dégradé conique, appliquée aux actions principales ── */
@property --gradient-angle{syntax:'<angle>';initial-value:0deg;inherits:false;}
@property --gradient-angle-offset{syntax:'<angle>';initial-value:0deg;inherits:false;}
@property --gradient-percent{syntax:'<percentage>';initial-value:5%;inherits:false;}
@property --gradient-shine{syntax:'<color>';initial-value:#ff9955;inherits:false;}
.shiny{--shiny-fill:var(--ink);position:relative;overflow:hidden;isolation:isolate;outline-offset:4px;border:1px solid transparent;
  background:linear-gradient(var(--shiny-fill),var(--shiny-fill)) padding-box,
    conic-gradient(from calc(var(--gradient-angle) - var(--gradient-angle-offset)),transparent,var(--orange) var(--gradient-percent),var(--gradient-shine) calc(var(--gradient-percent) * 2),var(--orange) calc(var(--gradient-percent) * 3),transparent calc(var(--gradient-percent) * 4)) border-box;
  box-shadow:inset 0 0 0 1px var(--slate);transition:800ms cubic-bezier(.25,1,.5,1);transition-property:--gradient-angle-offset,--gradient-percent,--gradient-shine;
  animation:shiny-angle 3s linear infinite,shiny-angle 7.5s linear infinite reverse paused;animation-composition:add;}
.shiny::before,.shiny::after{content:'';pointer-events:none;position:absolute;inset-inline-start:50%;inset-block-start:50%;translate:-50% -50%;z-index:0;}
.shiny::before{--dot:2px;--space:calc(var(--dot) * 2);width:calc(100% - 6px);height:calc(100% - 6px);
  background:radial-gradient(circle at var(--dot) var(--dot),rgba(255,255,255,.5) calc(var(--dot)/4),transparent 0) padding-box;
  background-size:var(--space) var(--space);background-repeat:space;
  mask-image:conic-gradient(from calc(var(--gradient-angle) + 45deg),black,transparent 10% 90%,black);border-radius:inherit;opacity:.35;
  animation:shiny-angle 3s linear infinite,shiny-angle 7.5s linear infinite reverse paused;animation-composition:add;}
.shiny::after{width:100%;aspect-ratio:1;background:linear-gradient(-50deg,transparent,var(--orange),transparent);
  mask-image:radial-gradient(circle at bottom,transparent 40%,black);opacity:.5;
  animation:shiny-shimmer 3s linear infinite,shiny-shimmer 7.5s linear infinite reverse paused;animation-composition:add;}
.shiny span{position:relative;z-index:1;display:inline-flex;align-items:center;gap:6px;}
.shiny span::before{content:'';pointer-events:none;position:absolute;inset-inline-start:50%;inset-block-start:50%;translate:-50% -50%;
  width:calc(100% + 1rem);height:calc(100% + 1rem);box-shadow:inset 0 -1ex 2rem 4px var(--orange);opacity:0;
  transition:opacity 800ms cubic-bezier(.25,1,.5,1);animation:shiny-breathe 4.5s linear infinite;}
.shiny:is(:hover,:focus-visible){--gradient-percent:20%;--gradient-angle-offset:95deg;--gradient-shine:#ffb380;}
.shiny:is(:hover,:focus-visible) span::before{opacity:1;}
.cta-sparkle{width:15px;height:15px;flex-shrink:0;filter:drop-shadow(0 0 3px currentColor);animation:shiny-breathe 4.5s linear infinite;}
@keyframes shiny-angle{to{--gradient-angle:360deg;}}
@keyframes shiny-shimmer{to{rotate:360deg;}}
@keyframes shiny-breathe{from,to{scale:1;}50%{scale:1.2;}}
@media (prefers-reduced-motion: reduce){.shiny,.shiny::before,.shiny::after{animation:none;}.cta-sparkle{animation:none;}}

/* ── Footer cinématique : fond encre, grille, halo, wordmark géant, marquee ── */
footer{position:relative;overflow:hidden;background:var(--ink);color:rgba(244,244,245,.75);padding:72px 0 32px;margin-top:40px;}
footer a{color:rgba(244,244,245,.85);}
footer a:hover{color:var(--orange);}
.cine-grid{position:absolute;inset:0;z-index:0;pointer-events:none;background-size:56px 56px;
  background-image:linear-gradient(to right,rgba(244,244,245,.05) 1px,transparent 1px),linear-gradient(to bottom,rgba(244,244,245,.05) 1px,transparent 1px);
  -webkit-mask-image:linear-gradient(to bottom,transparent,#000 25%);mask-image:linear-gradient(to bottom,transparent,#000 25%);}
.cine-aurora{position:absolute;z-index:0;pointer-events:none;left:50%;top:-10%;width:60vw;height:60vw;max-width:640px;max-height:640px;transform:translateX(-50%);
  background:radial-gradient(circle,rgba(255,90,0,.28) 0%,rgba(255,90,0,.08) 45%,transparent 70%);filter:blur(50px);border-radius:50%;
  animation:cine-breathe 8s ease-in-out infinite alternate;}
@keyframes cine-breathe{0%{transform:translateX(-50%) scale(1);opacity:.7;}100%{transform:translateX(-50%) scale(1.15);opacity:1;}}
.cine-giant{position:absolute;z-index:0;pointer-events:none;left:50%;bottom:-3.5vw;transform:translateX(-50%);white-space:nowrap;user-select:none;
  font-family:'DM Sans',sans-serif;font-weight:800;font-size:15vw;line-height:.8;letter-spacing:-0.03em;color:transparent;
  background:linear-gradient(180deg,rgba(244,244,245,.08) 0%,transparent 65%);-webkit-background-clip:text;background-clip:text;}
.cine-marquee{position:relative;z-index:1;overflow:hidden;border-top:1px solid rgba(244,244,245,.12);border-bottom:1px solid rgba(244,244,245,.12);padding:14px 0;margin-bottom:48px;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);}
.cine-marquee-track{display:flex;width:max-content;animation:footer-scroll-left 30s linear infinite;}
.cine-marquee-track span{display:flex;align-items:center;padding:0 18px;font-size:12.5px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:rgba(244,244,245,.5);white-space:nowrap;}
.cine-marquee-track span.dot{color:var(--orange);padding:0 2px;}
@keyframes footer-scroll-left{from{transform:translateX(0);}to{transform:translateX(-50%);}}
.footer-content{position:relative;z-index:1;}
.footer-content p{margin-bottom:14px;}
.footer-top{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;margin-bottom:32px;}
.footer-desc{max-width:320px;color:rgba(244,244,245,.6);font-size:14px;line-height:1.6;margin-top:16px;}
.footer-links{display:flex;gap:56px;flex-wrap:wrap;}
.footer-col h4{font-size:12px;text-transform:uppercase;letter-spacing:0.04em;color:rgba(244,244,245,.4);margin-bottom:14px;}
.footer-col a{display:block;font-size:14px;margin-bottom:10px;color:rgba(244,244,245,.85);}
.footer-col a:hover{color:var(--orange);}
.footer-villes{font-size:13px;color:rgba(244,244,245,.5);}
.footer-villes a{color:rgba(244,244,245,.7);}
.footer-bottom{border-top:1px solid rgba(244,244,245,.12);padding:20px 90px 0 0;margin-top:24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;font-size:12.5px;color:rgba(244,244,245,.5);text-transform:uppercase;letter-spacing:.03em;}
.cine-credit{display:inline-flex;align-items:center;gap:8px;padding:9px 18px;border-radius:100px;background:rgba(244,244,245,.05);border:1px solid rgba(244,244,245,.12);backdrop-filter:blur(8px);text-transform:none;}
.cine-heart{color:var(--orange);display:inline-block;animation:cine-heartbeat 2s ease-in-out infinite;}
@keyframes cine-heartbeat{0%,100%{transform:scale(1);}25%{transform:scale(1.3);}40%{transform:scale(1);}}
.cine-top{width:38px;height:38px;border-radius:50%;background:rgba(244,244,245,.05);border:1px solid rgba(244,244,245,.15);color:rgba(244,244,245,.7);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .3s cubic-bezier(.16,1,.3,1);flex-shrink:0;}
.cine-top:hover{background:rgba(244,244,245,.12);color:#fff;transform:translateY(-3px);}
.cine-reveal{opacity:0;transform:translateY(20px);transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1);}
.cine-reveal.in{opacity:1;transform:translateY(0);}
@media (prefers-reduced-motion: reduce){.cine-aurora,.cine-heart{animation:none;}.cine-marquee-track{animation:none;}.cine-reveal{transition:none;opacity:1;transform:none;}}
</style>

