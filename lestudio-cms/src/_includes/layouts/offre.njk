---
layout: layouts/base.njk
---
{% set crumbs = [ {name:"Accueil", url:"/"}, {name:"Offres", url:"/#offres"}, {name: title} ] %}
{% include "partials/breadcrumb.njk" %}
<h1 style="margin-top:16px;">{{ h1 or title }}</h1>
<p class="lede">{{ accroche or description }}</p>
<p style="font-family:'DM Sans',sans-serif;font-size:22px;font-weight:600;margin-bottom:8px;">{{ price }}</p>
<p style="font-size:13px;color:var(--grey);margin-bottom:28px;">{{ cible }}</p>
<a class="btn-primary" style="margin:0 0 64px;" href="{{ settings.rdv }}" target="_blank" rel="noopener" data-cal-namespace="20min" data-cal-link="sacha-vetzikian/20min"><span>Prendre rendez-vous avec Sacha</span></a>

{# ── Qualification ── #}
{% if pour_qui %}
<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:72px;" class="offre-qualif">
<div class="card" style="margin-bottom:0;">
<h3 style="margin-bottom:16px;">Cette offre est pour vous si...</h3>
{% for p in pour_qui %}<p style="padding:8px 0;border-top:1px solid var(--line);">✓&nbsp; {{ p }}</p>{% endfor %}
</div>
<div class="card" style="margin-bottom:0;background:var(--slate);color:var(--paper);border:none;">
<h3 style="margin-bottom:16px;color:var(--paper);">Elle n'est pas pour vous si...</h3>
{% for p in pas_pour_qui %}<p style="padding:8px 0;border-top:1px solid rgba(244,244,245,0.15);color:rgba(244,244,245,0.85);">✕&nbsp; {{ p }}</p>{% endfor %}
</div>
</div>
{% endif %}

{# ── Déroulé ── #}
{% if roadmap %}
<h2>Le déroulé, sans surprise</h2>
{% for step in roadmap %}
<div style="display:grid;grid-template-columns:140px 1fr;gap:24px;padding:24px 0;border-top:1px solid var(--line);" class="offre-step">
<p style="font-family:'DM Sans',sans-serif;font-weight:600;color:var(--orange);">{{ step.periode }}</p>
<div>
<h3 style="font-family:'DM Sans',sans-serif;font-size:18px;margin-bottom:8px;">{{ step.titre }}</h3>
{% for pt in step.points %}<p style="font-size:15px;line-height:1.7;color:var(--grey);">— {{ pt }}</p>{% endfor %}
</div>
</div>
{% endfor %}
{% endif %}

{# ── Inclus + prix ── #}
<div style="display:grid;grid-template-columns:1.4fr 1fr;gap:20px;margin:64px 0;" class="offre-inclus">
<div class="card" style="margin-bottom:0;">
<h3 style="margin-bottom:16px;">Ce qui est inclus</h3>
{% for item in inclus %}<p style="padding:8px 0;border-top:1px solid var(--line);">✓&nbsp; {{ item }}</p>{% endfor %}
</div>
<div class="card" style="margin-bottom:0;background:var(--slate);border:none;display:flex;flex-direction:column;justify-content:center;">
<p style="font-size:13px;text-transform:uppercase;letter-spacing:0.04em;color:var(--orange);margin-bottom:8px;">Tarif</p>
<p style="font-family:'DM Sans',sans-serif;font-size:30px;font-weight:600;color:#fff;margin-bottom:6px;">{{ price }}</p>
<p style="font-size:14px;color:rgba(255,255,255,0.75);margin-bottom:20px;">Le montant exact dépend de votre périmètre, fixé ensemble après le premier appel.</p>
<p style="font-size:13px;color:rgba(255,255,255,0.7);">Outils : {{ outils | join(" · ") }}</p>
</div>
</div>

{# ── Contenu libre (markdown du fichier) ── #}
{{ content | safe }}

{# ── FAQ dédiée ── #}
{% if faq %}
<h2>Vos questions avant de vous décider</h2>
<div style="margin-bottom:64px;">
{% for f in faq %}
<details style="border-top:1px solid var(--line);padding:18px 0;">
<summary style="font-family:'DM Sans',sans-serif;font-weight:600;font-size:17px;cursor:pointer;">{{ f.q }}</summary>
<p style="margin-top:12px;line-height:1.7;color:var(--grey);max-width:680px;">{{ f.r }}</p>
</details>
{% endfor %}
</div>
{% endif %}

{# ── Cas clients ── #}
<h2>Ils sont passés par là</h2>
<div class="case-grid">
{% set shown = 0 %}
{% for r in collections.realisations %}
{% if r.data.featured and shown < 3 %}
{% set shown = shown + 1 %}
<a class="card" href="/realisations/{{ r.fileSlug }}/">
<h3>{{ r.data.client }}</h3><p>{{ r.data.description }}</p>
<p style="margin-top:14px;color:var(--orange);font-weight:500;font-size:14px;">→ Voir le projet</p>
</a>
{% endif %}
{% endfor %}
</div>


{% if faq %}
<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"FAQPage",
 "mainEntity":[{% for f in faq %}{"@type":"Question","name":{{ f.q | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.r | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]
}
</script>
{% endif %}
<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"BreadcrumbList",
 "itemListElement":[
  {"@type":"ListItem","position":1,"name":"Accueil","item":"https://www.lestudiodesign.fr/"},
  {"@type":"ListItem","position":2,"name":"Offres","item":"https://www.lestudiodesign.fr/#offres"},
  {"@type":"ListItem","position":3,"name":{{ title | dump | safe }},"item":"https://www.lestudiodesign.fr{{ page.url }}"}
 ]
}
</script>
{% include "partials/form-contact.njk" %}

<style>@media (max-width:800px){ .offre-qualif, .offre-inclus{grid-template-columns:1fr !important;} .offre-step{grid-template-columns:1fr !important;gap:6px !important;} }</style>
