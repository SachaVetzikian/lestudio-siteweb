---
layout: layouts/base.njk
---
{% set toc = content | toc %}
{% set minutes = content | readingTime %}
{% set shareUrl = "https://www.lestudiodesign.fr" + page.url %}
{% set sharePrompt = "Résume cet article : " + shareUrl %}
{% set crumbs = [ {name:"Accueil", url:"/"}, {name:"Blog", url:"/blog/"}, {name: title} ] %}
{% include "partials/breadcrumb.njk" %}

<p style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;font-size:13px;color:var(--grey);margin-top:16px;">
<span style="display:inline-block;background:var(--orange);color:#fff;font-weight:500;padding:4px 12px;border-radius:8px;">{{ category or "Stratégie" }}</span>
<span>·</span>
<span>{{ date | readableDate }}</span>
<span>·</span>
<span>{{ minutes }} min de lecture</span>
</p>

<h1 style="margin-top:12px;">{{ title }}</h1>
<p class="lede">{{ description }}</p>

{% set shareBtn = "display:flex;align-items:center;justify-content:center;border:1px solid var(--line);border-radius:12px;padding:12px 16px;font-size:14px;font-weight:500;color:var(--ink);background:#fff;" %}
<div class="card">
<h3 style="margin-bottom:16px;">Résumer cet article avec :</h3>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
<a href="https://chatgpt.com/?q={{ sharePrompt | urlencode }}" target="_blank" rel="noopener" style="{{ shareBtn }}">ChatGPT</a>
<a href="https://www.perplexity.ai/search?q={{ sharePrompt | urlencode }}" target="_blank" rel="noopener" style="{{ shareBtn }}">Perplexity</a>
<a href="https://claude.ai/new?q={{ sharePrompt | urlencode }}" target="_blank" rel="noopener" style="{{ shareBtn }}">Claude</a>
<a href="https://grok.com/?q={{ sharePrompt | urlencode }}" target="_blank" rel="noopener" style="{{ shareBtn }}">Grok</a>
</div>
</div>

{% if quiz %}
<div class="card" id="quiz-box" style="padding:32px 28px;">
<p style="font-size:12px;text-transform:uppercase;letter-spacing:0.04em;color:var(--orange);margin-bottom:10px;">Quiz interactif</p>
<h3 style="margin-bottom:4px;">{{ quiz.title }}</h3>
<p id="quiz-progress-label" style="font-size:13px;color:var(--grey);margin-bottom:16px;">Question 1/{{ quiz.questions.length }}</p>
<div style="width:100%;height:4px;background:var(--line);border-radius:4px;margin-bottom:24px;overflow:hidden;">
<div id="quiz-progress-bar" style="width:{{ (100/quiz.questions.length) }}%;height:100%;background:var(--orange);transition:width .3s ease;"></div>
</div>
{% for q in quiz.questions %}
<div class="quiz-question" style="{% if not loop.first %}display:none;{% endif %}">
<p style="font-weight:500;margin-bottom:14px;">{{ q.q }}</p>
{% for opt in q.options %}
<button type="button" class="quiz-option" data-value="{{ opt.value }}" style="display:block;width:100%;text-align:left;border:1px solid var(--line);border-radius:14px;padding:14px 16px;margin-bottom:10px;background:#fff;cursor:pointer;font-size:14.5px;color:var(--ink);">{{ opt.label }}</button>
{% endfor %}
</div>
{% endfor %}
<div id="quiz-results" style="display:none;">
{% for r in quiz.results %}
<div class="quiz-result" data-value="{{ r.value }}" style="display:none;">
<p style="font-weight:600;font-size:18px;margin-bottom:8px;color:var(--ink);">{{ r.title }}</p>
<p style="color:var(--grey);margin-bottom:16px;">{{ r.text }}</p>
{% if r.cta_url %}<a class="btn-primary" style="margin:0;" href="{{ r.cta_url }}"><span>{{ r.cta_label or "En savoir plus" }}</span></a>{% endif %}
</div>
{% endfor %}
</div>
</div>
<script>
(function(){
  var box = document.getElementById('quiz-box');
  if (!box) return;
  var questions = Array.prototype.slice.call(box.querySelectorAll('.quiz-question'));
  var total = questions.length;
  var progressLabel = document.getElementById('quiz-progress-label');
  var progressBar = document.getElementById('quiz-progress-bar');
  var resultsBox = document.getElementById('quiz-results');
  var scores = {};
  var current = 0;
  questions.forEach(function (qEl) {
    Array.prototype.slice.call(qEl.querySelectorAll('.quiz-option')).forEach(function (btn) {
      btn.addEventListener('click', function () {
        var val = btn.getAttribute('data-value');
        scores[val] = (scores[val] || 0) + 1;
        current++;
        if (current < total) {
          qEl.style.display = 'none';
          questions[current].style.display = 'block';
          progressLabel.textContent = 'Question ' + (current + 1) + '/' + total;
          progressBar.style.width = Math.round(((current + 1) / total) * 100) + '%';
        } else {
          qEl.style.display = 'none';
          progressLabel.style.display = 'none';
          var winner = null, max = 0;
          Object.keys(scores).forEach(function (k) {
            if (scores[k] > max) { max = scores[k]; winner = k; }
          });
          resultsBox.style.display = 'block';
          Array.prototype.slice.call(resultsBox.querySelectorAll('.quiz-result')).forEach(function (r) {
            if (r.getAttribute('data-value') === winner) r.style.display = 'block';
          });
        }
      });
    });
  });
})();
</script>
{% endif %}

{% if cover %}
<img src="{{ cover }}" alt="{{ title }}" width="1600" height="1000" fetchpriority="high" style="width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:14px;border:1px solid var(--line);margin:0 0 40px;"/>
{% endif %}

{% if reponse_courte %}
<div class="card" style="background:#FFF7E6;border:1px solid #F5DFA6;">
<h3 style="margin-bottom:12px;">💡 La réponse courte</h3>
<p style="color:var(--ink);">{{ reponse_courte }}</p>
</div>
{% endif %}

{% if key_takeaways %}
<div class="card" style="background:var(--orange-light);border:none;">
<h3 style="margin-bottom:12px;">✓ L'essentiel</h3>
{% for k in key_takeaways %}<p style="padding:6px 0;">✓&nbsp; {{ k }}</p>{% endfor %}
</div>
{% endif %}

{% if pour_qui or pas_pour_qui %}
<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:32px;" class="offre-qualif">
<div class="card" style="margin-bottom:0;">
<h3 style="margin-bottom:16px;">🏆 Fait pour vous si...</h3>
{% for p in pour_qui %}<p style="padding:8px 0;border-top:1px solid var(--line);">✓&nbsp; {{ p }}</p>{% endfor %}
</div>
<div class="card" style="margin-bottom:0;background:var(--slate);color:var(--paper);border:none;">
<h3 style="margin-bottom:16px;color:var(--paper);">Pas pour vous si...</h3>
{% for p in pas_pour_qui %}<p style="padding:8px 0;border-top:1px solid rgba(244,244,245,0.15);color:rgba(244,244,245,0.85);">✕&nbsp; {{ p }}</p>{% endfor %}
</div>
</div>
{% endif %}

{% if toc.length > 1 %}
<nav aria-label="Sommaire" class="card" style="padding:24px 28px;">
<h3 style="margin-bottom:12px;">Sommaire</h3>
<ol style="list-style:none;">
{% for item in toc %}
<li style="{% if item.level == 3 %}margin-left:18px;{% endif %}padding:5px 0;"><a href="#{{ item.id }}" style="color:var(--grey);font-size:14.5px;">{{ item.text }}</a></li>
{% endfor %}
</ol>
</nav>
{% endif %}

<div class="article-body">
{{ content | safe }}
</div>

{% if bon_a_savoir %}
<div class="card" style="background:#fff;border:1px solid var(--line);">
<h3 style="margin-bottom:12px;">ℹ️ Bon à savoir</h3>
<p style="color:var(--grey);">{{ bon_a_savoir }}</p>
</div>
{% endif %}

{% if faq %}
<h2>Questions fréquentes</h2>
<div style="margin-bottom:48px;">
{% for f in faq %}
<details style="border-top:1px solid var(--line);padding:18px 0;">
<summary style="font-family:'DM Sans',sans-serif;font-weight:600;font-size:17px;cursor:pointer;">{{ f.q }}</summary>
<p style="margin-top:12px;line-height:1.7;color:var(--grey);max-width:680px;">{{ f.r }}</p>
</details>
{% endfor %}
</div>
{% endif %}

{% if sources %}
<div class="card" style="background:#EAF2FF;border:1px solid #CFE0FF;">
<h3 style="margin-bottom:12px;">📚 Sources</h3>
{% for s in sources %}<p style="padding:4px 0;">• <a href="{{ s.url }}" target="_blank" rel="noopener" style="color:var(--ink);text-decoration:underline;">{{ s.label }}</a></p>{% endfor %}
</div>
{% endif %}

<div class="card" style="display:flex;gap:16px;align-items:center;margin:48px 0;">
<img src="/sacha-avatar.webp" alt="Sacha Vetzikian" width="56" height="56" loading="lazy" style="width:56px;height:56px;border-radius:50%;object-fit:cover;flex-shrink:0;"/>
<div>
<p style="font-weight:500;color:var(--ink);">Sacha Vetzikian</p>
<p style="font-size:13px;color:var(--grey);">Fondateur de LeStudio, designer UX/UI &amp; CRO depuis 2015 · <a href="https://www.linkedin.com/in/sacha-vetzikian/" target="_blank" rel="noopener" style="color:var(--orange);">LinkedIn</a></p>
</div>
</div>

{% if ressources_utiles %}
<h2>Ressources utiles</h2>
<div style="margin-bottom:32px;">
{% for r in ressources_utiles %}<p style="padding:4px 0;">• <a href="{{ r.url }}" style="color:var(--orange);">{{ r.label }}</a></p>{% endfor %}
</div>
{% endif %}

{% if collections.blog.length > 1 %}
{% set shown = 0 %}
<h2>À lire aussi</h2>
<div class="case-grid">
{% for p in collections.blog %}
{% if p.url != page.url and shown < 3 %}
{% set shown = shown + 1 %}
<a class="card" href="{{ p.url }}">
<h3>{{ p.data.title }}</h3><p>{{ p.data.description }}</p>
<p style="margin-top:14px;color:var(--orange);font-weight:500;font-size:14px;">→ Lire l'article</p>
</a>
{% endif %}
{% endfor %}
</div>
{% endif %}

<a class="btn-primary" href="{{ settings.rdv }}" target="_blank" rel="noopener" data-cal-namespace="20min" data-cal-link="sacha-vetzikian/20min"><span>Discuter d'un projet</span></a>

<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"Article",
 "headline":{{ title | dump | safe }},
 "description":{{ description | dump | safe }},
 "datePublished":"{{ date | isoDate }}",
 "author":{"@type":"Person","name":"Sacha Vetzikian"},
 "publisher":{"@type":"Organization","name":"LeStudio","logo":{"@type":"ImageObject","url":"https://www.lestudiodesign.fr/static/icon-192.png"}},
 {% if cover %}"image":"https://www.lestudiodesign.fr{{ cover }}",{% endif %}
 "mainEntityOfPage":{"@type":"WebPage","@id":"{{ shareUrl }}"}
}
</script>
{% if faq %}
<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"FAQPage",
 "mainEntity":[{% for f in faq %}{"@type":"Question","name":{{ f.q | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.r | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]
}
</script>
{% endif %}
<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"BreadcrumbList",
 "itemListElement":[
  {"@type":"ListItem","position":1,"name":"Accueil","item":"https://www.lestudiodesign.fr/"},
  {"@type":"ListItem","position":2,"name":"Blog","item":"https://www.lestudiodesign.fr/blog/"},
  {"@type":"ListItem","position":3,"name":{{ title | dump | safe }},"item":"{{ shareUrl }}"}
 ]
}
</script>

<style>
.article-body h2{font-size:clamp(22px,3vw,28px);margin:48px 0 16px;scroll-margin-top:100px;}
.article-body h3{font-size:19px;margin:32px 0 12px;scroll-margin-top:100px;}
.article-body h4{font-family:'DM Sans',sans-serif;font-weight:600;font-size:17px;margin:28px 0 10px;scroll-margin-top:100px;}
.article-body p{line-height:1.7;color:var(--grey);margin-bottom:16px;max-width:680px;}
.article-body img{width:100%;border-radius:14px;margin:24px 0;}
.article-body ul,.article-body ol{margin:0 0 16px 20px;color:var(--grey);line-height:1.7;}
.article-body hr{border:none;border-top:1px solid var(--line);margin:40px 0;}
.article-body table{width:100%;border-collapse:collapse;margin:8px 0 24px;font-size:14.5px;max-width:680px;}
.article-body th,.article-body td{padding:10px 14px;border:1px solid var(--line);text-align:left;}
.article-body th{background:#fff;font-weight:600;color:var(--ink);}
.article-body td{color:var(--grey);}
@media (max-width:640px){ .offre-qualif{grid-template-columns:1fr !important;} .article-body table{display:block;overflow-x:auto;} }
</style>
