---
layout: layouts/base.njk
---
{% set toc = content | toc %}
{% set minutes = content | readingTime %}
<p style="margin-top:80px;font-size:12px;text-transform:uppercase;letter-spacing:0.04em;color:var(--grey);"><a href="/blog/">← Tous les articles</a></p>

<p style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;font-size:13px;color:var(--grey);margin-top:16px;">
<span style="color:var(--orange);font-weight:500;">{{ category or "Stratégie" }}</span>
<span>·</span>
<span>{{ date | readableDate }}</span>
<span>·</span>
<span>{{ minutes }} min de lecture</span>
</p>

<h1 style="margin-top:12px;">{{ title }}</h1>
<p class="lede">{{ description }}</p>

{% if cover %}
<img src="{{ cover }}" alt="{{ title }}" width="1600" height="1000" fetchpriority="high" style="width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:14px;border:1px solid var(--line);margin:0 0 40px;"/>
{% endif %}

{% if key_takeaways %}
<div class="card" style="background:var(--orange-light);border:none;">
<h3 style="margin-bottom:12px;">L'essentiel</h3>
{% for k in key_takeaways %}<p style="padding:6px 0;">✓&nbsp; {{ k }}</p>{% endfor %}
</div>
{% endif %}

{% if toc.length > 1 %}
<nav aria-label="Sommaire" class="card" style="padding:24px 28px;">
<h3 style="margin-bottom:12px;">Sommaire</h3>
<ol style="list-style:none;">
{% for item in toc %}
<li style="{% if item.level == 3 %}margin-left:18px;{% endif %}padding:5px 0;"><a href="#{{ item.id }}" style="color:var(--grey);font-size:14.5px;">{{ item.text }}</a></li>
{% endfor %}
</ol>
</nav>
{% endif %}

<div class="article-body">
{{ content | safe }}
</div>

{% if faq %}
<h2>Questions fréquentes</h2>
<div style="margin-bottom:48px;">
{% for f in faq %}
<details style="border-top:1px solid var(--line);padding:18px 0;">
<summary style="font-family:'DM Sans',sans-serif;font-weight:600;font-size:17px;cursor:pointer;">{{ f.q }}</summary>
<p style="margin-top:12px;line-height:1.7;color:var(--grey);max-width:680px;">{{ f.r }}</p>
</details>
{% endfor %}
</div>
{% endif %}

<div class="card" style="display:flex;gap:16px;align-items:center;margin:48px 0;">
<img src="/sacha-avatar.webp" alt="Sacha Vetzikian" width="56" height="56" loading="lazy" style="width:56px;height:56px;border-radius:50%;object-fit:cover;flex-shrink:0;"/>
<div>
<p style="font-weight:500;color:var(--ink);">Sacha Vetzikian</p>
<p style="font-size:13px;color:var(--grey);">Fondateur de LeStudio, designer UX/UI &amp; CRO depuis 2015 · <a href="https://www.linkedin.com/in/sacha-vetzikian/" target="_blank" rel="noopener" style="color:var(--orange);">LinkedIn</a></p>
</div>
</div>

{% if collections.blog.length > 1 %}
{% set shown = 0 %}
<h2>À lire aussi</h2>
<div class="case-grid">
{% for p in collections.blog %}
{% if p.url != page.url and shown < 3 %}
{% set shown = shown + 1 %}
<a class="card" href="{{ p.url }}">
<h3>{{ p.data.title }}</h3><p>{{ p.data.description }}</p>
<p style="margin-top:14px;color:var(--orange);font-weight:500;font-size:14px;">→ Lire l'article</p>
</a>
{% endif %}
{% endfor %}
</div>
{% endif %}

<a class="btn-primary" href="{{ settings.rdv }}" target="_blank" rel="noopener">Discuter d'un projet ›</a>

<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"Article",
 "headline":{{ title | dump | safe }},
 "description":{{ description | dump | safe }},
 "datePublished":"{{ date | isoDate }}",
 "author":{"@type":"Person","name":"Sacha Vetzikian"},
 "publisher":{"@type":"Organization","name":"LeStudio","logo":{"@type":"ImageObject","url":"https://www.lestudiodesign.fr/static/icon-192.png"}},
 {% if cover %}"image":"https://www.lestudiodesign.fr{{ cover }}",{% endif %}
 "mainEntityOfPage":{"@type":"WebPage","@id":"https://www.lestudiodesign.fr{{ page.url }}"}
}
</script>
{% if faq %}
<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"FAQPage",
 "mainEntity":[{% for f in faq %}{"@type":"Question","name":{{ f.q | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.r | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]
}
</script>
{% endif %}
<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"BreadcrumbList",
 "itemListElement":[
  {"@type":"ListItem","position":1,"name":"Accueil","item":"https://www.lestudiodesign.fr/"},
  {"@type":"ListItem","position":2,"name":"Blog","item":"https://www.lestudiodesign.fr/blog/"},
  {"@type":"ListItem","position":3,"name":{{ title | dump | safe }},"item":"https://www.lestudiodesign.fr{{ page.url }}"}
 ]
}
</script>

<style>
.article-body h2{font-size:clamp(22px,3vw,28px);margin:48px 0 16px;scroll-margin-top:100px;}
.article-body h3{font-size:19px;margin:32px 0 12px;scroll-margin-top:100px;}
.article-body p{line-height:1.7;color:var(--grey);margin-bottom:16px;max-width:680px;}
.article-body img{width:100%;border-radius:14px;margin:24px 0;}
.article-body ul,.article-body ol{margin:0 0 16px 20px;color:var(--grey);line-height:1.7;}
.article-body hr{border:none;border-top:1px solid var(--line);margin:40px 0;}
</style>
