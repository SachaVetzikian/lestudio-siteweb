---
layout: layouts/base.njk
---
<p style="margin-top:80px;font-size:12px;letter-spacing:0.04em;color:var(--grey);"><a href="/blog/">← Tous les articles</a></p>
<h1 style="margin-top:16px;">{{ title }}</h1>
<p class="lede">{{ description }}</p>
<p style="font-size:13px;color:var(--grey);margin-bottom:28px;">{{ date | readableDate }}</p>

{% if cover %}
<img src="{{ cover }}" alt="{{ title }}" width="1600" height="1000" fetchpriority="high" style="width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:14px;border:1px solid var(--line);margin:0 0 56px;"/>
{% endif %}

<div class="article-body">
{{ content | safe }}
</div>

<a class="btn-primary" href="{{ settings.rdv }}" target="_blank" rel="noopener">Discuter d'un projet ›</a>

<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"Article",
 "headline":{{ title | dump | safe }},
 "description":{{ description | dump | safe }},
 "datePublished":"{{ date | isoDate }}",
 "author":{"@type":"Person","name":"Sacha Vetzikian"},
 "publisher":{"@type":"Organization","name":"LeStudio","logo":{"@type":"ImageObject","url":"https://www.lestudiodesign.fr/static/icon-192.png"}},
 {% if cover %}"image":"https://www.lestudiodesign.fr{{ cover }}",{% endif %}
 "mainEntityOfPage":{"@type":"WebPage","@id":"https://www.lestudiodesign.fr{{ page.url }}"}
}
</script>
<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"BreadcrumbList",
 "itemListElement":[
  {"@type":"ListItem","position":1,"name":"Accueil","item":"https://www.lestudiodesign.fr/"},
  {"@type":"ListItem","position":2,"name":"Blog","item":"https://www.lestudiodesign.fr/blog/"},
  {"@type":"ListItem","position":3,"name":{{ title | dump | safe }},"item":"https://www.lestudiodesign.fr{{ page.url }}"}
 ]
}
</script>

<style>.article-body h2{font-size:clamp(22px,3vw,28px);margin:48px 0 16px;} .article-body h3{font-size:19px;margin:32px 0 12px;} .article-body p{line-height:1.7;color:var(--grey);margin-bottom:16px;max-width:680px;} .article-body img{width:100%;border-radius:14px;margin:24px 0;} .article-body ul,.article-body ol{margin:0 0 16px 20px;color:var(--grey);line-height:1.7;}</style>
