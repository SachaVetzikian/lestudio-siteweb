---
layout: layouts/base.njk
---
{% set crumbs = [ {name:"Accueil", url:"/"}, {name:"Cas clients", url:"/cas-clients/"}, {name: client} ] %}
{% include "partials/breadcrumb.njk" %}
<span class="eyebrow" style="margin-top:16px;">{% if type == "ecommerce" %}Refonte e-commerce{% else %}Refonte site vitrine{% endif %} · {{ year }}</span>
<h1 style="margin-top:8px;">{{ title }}</h1>
{% if probleme %}<p class="lede" style="margin-bottom:12px;">{{ probleme }}</p>{% endif %}
{% if mission %}<p class="lede">{{ mission }}</p>{% elif not probleme %}<p class="lede">{{ description }}</p>{% endif %}

{% if video and video | assetExists %}
<video controls playsinline preload="metadata" width="1600" height="1000" style="width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:6px;margin:24px 0 56px;box-shadow:var(--glow-shadow);"><source src="{{ video }}" type="video/mp4"></video>
{% elif cover %}
<img src="{{ cover }}" alt="{{ title }}" width="1600" height="1000" fetchpriority="high" style="width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:6px;margin:24px 0 56px;box-shadow:var(--glow-shadow);"/>
{% else %}
<div style="position:relative;width:100%;aspect-ratio:16/10;border-radius:6px;margin:24px 0 56px;overflow:hidden;background:radial-gradient(120% 100% at 20% 0%,rgba(255,255,255,.14),var(--ink) 65%);display:flex;align-items:center;justify-content:center;">
<span class="crosshair" style="top:14%;left:10%;"></span>
<span class="crosshair" style="bottom:16%;right:12%;"></span>
<span style="font-family:var(--sans);font-weight:900;letter-spacing:-0.01em;font-size:clamp(22px,3.4vw,40px);color:#fff;">{{ client }}</span>
</div>
{% endif %}

{% if resultats %}
<div style="display:flex;flex-wrap:wrap;gap:48px;margin:-24px 0 64px;padding-bottom:40px;border-bottom:1px solid var(--line);">
{% for res in resultats %}
<div>
<p style="font-family:var(--sans);font-size:clamp(32px,4vw,52px);font-weight:900;letter-spacing:-0.02em;color:var(--ink);line-height:1;">{{ res.chiffre }}</p>
<p style="font-size:13.5px;color:var(--ink-40);margin-top:6px;">{{ res.label }}</p>
</div>
{% endfor %}
</div>
{% endif %}

{# ── Vue d'ensemble ── #}
<div class="prose-block" style="margin-bottom:0;max-width:760px;">
{% if overview.statement %}<h2 style="margin-top:0;">{{ overview.statement }}</h2>{% endif %}
{% if overview.qui %}<p style="line-height:1.7;color:var(--ink-60);margin-bottom:18px;">{{ overview.qui }}</p>{% endif %}
{% if overview.depart %}<p style="line-height:1.7;color:var(--ink-60);">{{ overview.depart }}</p>{% endif %}
</div>

{# ── Méta (plate, sans encadré) ── #}
<div class="meta-row">
<div>
<p>Type</p>
<p>{% if type == "ecommerce" %}E-commerce{% else %}Site vitrine{% endif %} · {{ year }}</p>
</div>
<div>
<p>Secteur</p>
<p>{{ tags | join(" · ") }}</p>
</div>
{% if services %}
<div>
<p>Services</p>
{% for sv in services %}<p>{{ sv }}</p>{% endfor %}
</div>
{% endif %}
</div>

{# ── Galerie visuelle ── #}
{% if gallery %}
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:24px;margin-bottom:72px;">
{% for im in gallery %}
<img src="{{ im }}" alt="{{ client }}" width="1200" height="675" loading="lazy" style="width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:14px;border:1px solid var(--line);"/>
{% endfor %}
</div>
{% endif %}

{# ── Phases numérotées ── #}
{% for ph in phases %}
<section style="border-top:1px solid var(--line);padding:56px 0;display:grid;grid-template-columns:120px 1fr;gap:32px;">
<div style="font-family:var(--sans);font-weight:900;font-size:clamp(52px,7vw,96px);line-height:1;color:var(--line);">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</div>
<div>
<h2 style="margin-top:0;font-size:clamp(26px,3.4vw,38px);">{{ ph.titre }}</h2>
{% if ph.intro %}<p style="line-height:1.7;color:var(--ink-60);max-width:640px;margin-bottom:28px;">{{ ph.intro }}</p>{% endif %}
{% if ph.blocs %}
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;margin-bottom:28px;">
{% for b in ph.blocs %}
<div class="card" style="margin-bottom:0;"><h3>{{ b.titre }}</h3><p>{{ b.texte }}</p></div>
{% endfor %}
</div>
{% endif %}
{% if ph.images %}
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:24px;">
{% for im in ph.images %}
<img src="{{ im }}" alt="{{ client }} · {{ ph.titre }}" width="1200" height="800" loading="lazy" style="width:100%;aspect-ratio:3/2;object-fit:cover;border-radius:4px;box-shadow:var(--glow-shadow);"/>
{% endfor %}
</div>
{% endif %}
</div>
</section>
{% endfor %}

{# ── Témoignage lié ── #}
{% if temoignage %}
{% for t in collections.temoignages %}{% if t.fileSlug == temoignage %}
<section style="border-top:1px solid var(--line);padding:64px 0;">
<div style="position:relative;background:var(--ink);border-radius:6px;padding:48px 44px;overflow:hidden;">
<span class="crosshair" style="top:20px;right:28px;"></span>
<p style="font-family:var(--sans);font-style:normal;font-weight:500;letter-spacing:-0.01em;font-size:clamp(19px,2.2vw,24px);line-height:1.4;color:#fff;max-width:680px;">« {{ t.data.quote | replace("**","") }} »</p>
<p style="margin-top:22px;font-weight:600;color:#fff;">{{ t.data.name }}</p>
<p style="font-size:13px;color:rgba(255,255,255,0.55);">{{ t.data.role }}</p>
</div>
</section>
{% endif %}{% endfor %}
{% endif %}

{{ content | safe }}

{# ── Autres projets ── #}
<section style="border-top:1px solid var(--line);padding:56px 0 0;">
<h2 style="margin-top:0;">Autres projets</h2>
<div class="case-list" style="margin-top:8px;">
{% set shown = 0 %}
{% for r in collections.realisations %}
{% if r.fileSlug != page.fileSlug and shown < 3 %}
{% set shown = shown + 1 %}
<a class="case-row" href="/realisations/{{ r.fileSlug }}/">
<span class="case-row-year">{{ r.data.year }}</span>
<div class="case-row-title">
<h3>{{ r.data.client }}</h3>
<div class="case-row-meta"><span>{{ r.data.description }}</span></div>
</div>
{% if r.data.cover and (r.data.cover | assetExists) %}
<div class="case-row-thumb"><img src="{{ r.data.cover }}" alt="{{ r.data.client }}" loading="lazy"/></div>
{% endif %}
<span class="case-row-arrow"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></span>
</a>
{% endif %}
{% endfor %}
</div>
</section>

<a class="link-cta" style="margin:0 0 80px;" href="{{ settings.rdv }}" target="_blank" rel="noopener" data-cal-namespace="20min" data-cal-link="sacha-vetzikian/20min">Discuter d'un projet similaire<span class="arrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></span></a>

<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"BreadcrumbList",
 "itemListElement":[
  {"@type":"ListItem","position":1,"name":"Accueil","item":"https://www.lestudiodesign.fr/"},
  {"@type":"ListItem","position":2,"name":"Cas clients","item":"https://www.lestudiodesign.fr/cas-clients/"},
  {"@type":"ListItem","position":3,"name":{{ client | dump | safe }},"item":"https://www.lestudiodesign.fr{{ page.url }}"}
 ]
}
</script>
