---
layout: layouts/base.njk
---
<p style="margin-top:80px;font-size:12px;text-transform:uppercase;letter-spacing:0.04em;color:var(--grey);"><a href="/cas-clients/">← Tous les cas clients</a></p>
<h1 style="margin-top:16px;">{{ title }}</h1>
{% if probleme %}<p class="lede" style="margin-bottom:12px;">{{ probleme }}</p>{% endif %}
{% if mission %}<p class="lede">{{ mission }}</p>{% elif not probleme %}<p class="lede">{{ description }}</p>{% endif %}

{% if video %}
<video controls playsinline preload="metadata" width="1600" height="1000" style="width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:14px;border:1px solid var(--line);margin:24px 0 56px;"><source src="{{ video }}" type="video/mp4"></video>
{% elif cover %}
<img src="{{ cover }}" alt="{{ title }}" width="1600" height="1000" fetchpriority="high" style="width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:14px;border:1px solid var(--line);margin:24px 0 56px;"/>
{% endif %}

{% if resultats %}
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:20px;margin:-24px 0 56px;">
{% for res in resultats %}
<div class="card" style="margin-bottom:0;text-align:center;">
<p style="font-family:'DM Sans',sans-serif;font-size:34px;font-weight:600;color:var(--orange);">{{ res.chiffre }}</p>
<p style="font-size:14px;color:var(--grey);">{{ res.label }}</p>
</div>
{% endfor %}
</div>
{% endif %}

{# ── Vue d'ensemble + méta ── #}
<div style="display:grid;grid-template-columns:2fr 1fr;gap:48px;margin-bottom:72px;" class="case-overview">
<div>
{% if overview.statement %}<h2 style="margin-top:0;">{{ overview.statement }}</h2>{% endif %}
{% if overview.qui %}<p style="line-height:1.7;color:var(--grey);margin-bottom:18px;">{{ overview.qui }}</p>{% endif %}
{% if overview.depart %}<p style="line-height:1.7;color:var(--grey);">{{ overview.depart }}</p>{% endif %}
</div>
<div>
<div class="card" style="position:sticky;top:100px;">
<p style="font-size:12px;text-transform:uppercase;letter-spacing:0.04em;color:var(--grey);margin-bottom:6px;">Type</p>
<p style="margin-bottom:18px;font-weight:500;color:var(--ink);">{% if type == "ecommerce" %}E-commerce{% else %}Site vitrine{% endif %} · {{ year }}</p>
<p style="font-size:12px;text-transform:uppercase;letter-spacing:0.04em;color:var(--grey);margin-bottom:6px;">Secteur</p>
<p style="margin-bottom:18px;font-weight:500;color:var(--ink);">{{ tags | join(" · ") }}</p>
{% if services %}
<p style="font-size:12px;text-transform:uppercase;letter-spacing:0.04em;color:var(--grey);margin-bottom:6px;">Services</p>
{% for sv in services %}<p style="font-weight:500;color:var(--ink);margin-bottom:4px;">{{ sv }}</p>{% endfor %}
{% endif %}
</div>
</div>
</div>

{# ── Phases numérotées ── #}
{% for ph in phases %}
<section style="border-top:1px solid var(--line);padding:56px 0;">
<h2 style="margin-top:0;"><span style="color:var(--orange);">{{ loop.index }}.</span> {{ ph.titre }}</h2>
{% if ph.intro %}<p style="line-height:1.7;color:var(--grey);max-width:640px;margin-bottom:28px;">{{ ph.intro }}</p>{% endif %}
{% if ph.blocs %}
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;margin-bottom:28px;">
{% for b in ph.blocs %}
<div class="card" style="margin-bottom:0;"><h3>{{ b.titre }}</h3><p>{{ b.texte }}</p></div>
{% endfor %}
</div>
{% endif %}
{% if ph.images %}
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;">
{% for im in ph.images %}
<img src="{{ im }}" alt="{{ client }} · {{ ph.titre }}" width="1200" height="800" loading="lazy" style="width:100%;aspect-ratio:3/2;object-fit:cover;border-radius:14px;border:1px solid var(--line);"/>
{% endfor %}
</div>
{% endif %}
</section>
{% endfor %}

{# ── Témoignage lié ── #}
{% if temoignage %}
{% for t in collections.temoignages %}{% if t.fileSlug == temoignage %}
<section style="border-top:1px solid var(--line);padding:56px 0;">
<div class="card" style="background:var(--ink);color:var(--paper);border:none;">
<p style="font-weight:500;font-size:20px;line-height:1.5;margin-bottom:20px;color:var(--paper);">« {{ t.data.quote | replace("**","") }} »</p>
<p style="font-weight:500;color:var(--paper);">{{ t.data.name }}</p>
<p style="font-size:13px;color:rgba(245,243,239,0.65);">{{ t.data.role }}</p>
</div>
</section>
{% endif %}{% endfor %}
{% endif %}

{{ content | safe }}

{# ── Autres projets ── #}
<section style="border-top:1px solid var(--line);padding:56px 0 0;">
<h2 style="margin-top:0;">Autres projets</h2>
<div class="case-grid">
{% set shown = 0 %}
{% for r in collections.realisations %}
{% if r.fileSlug != page.fileSlug and shown < 3 %}
{% set shown = shown + 1 %}
<a class="card" href="/realisations/{{ r.fileSlug }}/">
<h3>{{ r.data.client }}</h3><p>{{ r.data.description }}</p>
<p style="margin-top:14px;color:var(--orange);font-weight:500;font-size:14px;">→ Découvrir</p>
</a>
{% endif %}
{% endfor %}
</div>
</section>

<a class="btn-primary" href="{{ settings.rdv }}" target="_blank" rel="noopener">Discuter d'un projet similaire ›</a>

<style>@media (max-width:800px){ .case-overview{grid-template-columns:1fr !important;} }</style>
