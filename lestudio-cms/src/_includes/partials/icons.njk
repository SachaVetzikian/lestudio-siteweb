{# ── Mini-mockups d'étape méthode (repris du scroll-method homepage) : 4 variantes cycliques ── #}

{% macro methodMock(kind) %}
{% if kind == 1 %}
<div class="am-wrap"><div class="asset-mock"><div class="am-chrome"><div class="am-dots"><span></span><span></span><span></span></div><div class="am-label"><svg width="10" height="10" viewBox="0 0 24 24"><path fill="currentColor" d="M3 3h8v8H3zm10 0h8v5h-8zm0 7h8v11h-8zM3 13h8v8H3z"/></svg>Dashboard</div></div>
<div class="am-body">
<div style="display:flex; gap:8px; margin-bottom:14px;">
<div style="flex:1; border:1px solid var(--line); border-radius:2px; padding:8px;"><div style="font-family:var(--sans); font-weight:600; font-size:15px;">2.4%</div><div style="font-size:8.5px; color:var(--ink-40); margin-top:2px;">Conversion</div></div>
<div style="flex:1; border:1px solid var(--line); border-radius:2px; padding:8px;"><div style="font-family:var(--sans); font-weight:600; font-size:15px; color:var(--ink);">64%</div><div style="font-size:8.5px; color:var(--ink-40); margin-top:2px;">Rebond</div></div>
</div>
<svg width="100%" height="46" viewBox="0 0 240 46" preserveAspectRatio="none"><polyline points="0,36 40,30 80,34 120,18 160,22 200,8 240,12" fill="none" stroke="var(--ink)" stroke-width="2"/></svg>
<div class="am-cursor" style="top:8px; right:10px;">Benchmark ↗</div>
</div></div>
<div class="am-sticker" style="bottom:-14px; left:-16px;">Points bloquants ⚡</div></div>
{% elif kind == 2 %}
<div class="am-wrap"><div class="asset-mock"><div class="am-chrome"><div class="am-dots"><span></span><span></span><span></span></div><div class="am-label"><svg width="10" height="10" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M3 3h18v18H3z"/></svg>Wireframe</div></div>
<div class="am-body">
<div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px;">
<div style="height:30px; border:1.5px dashed var(--ink-40); border-radius:4px;"></div>
<div style="height:30px; border:1.5px dashed var(--ink-40); border-radius:4px;"></div>
</div>
<div style="height:16px; border:1.5px dashed var(--ink-40); border-radius:4px; margin-bottom:14px;"></div>
<div class="am-timeline"><span class="am-tick" style="left:0;">V1</span><span class="am-tick" style="left:44%;">V2</span><span class="am-tick" style="left:88%;">Final</span><div class="am-ruler"></div><div class="am-marker" style="left:44%;"></div></div>
<div class="am-cursor" style="bottom:6px; right:8px;">Structure ↗</div>
</div></div>
<div class="am-sticker" style="top:-14px; right:-12px;">Valider ✓</div></div>
{% elif kind == 3 %}
<div class="am-wrap"><div class="asset-mock"><div class="am-chrome"><div class="am-dots"><span></span><span></span><span></span></div><div style="display:flex; gap:4px;"><span class="am-swatch" style="background:var(--ink);"></span><span class="am-swatch" style="background:var(--ink-60);"></span><span class="am-swatch" style="background:var(--line);"></span></div><div class="am-label">BDO Grotesk ⌄</div></div>
<div class="am-body">
<div style="height:7px; width:32%; background:var(--line); border-radius:3px; margin-bottom:6px;"></div>
<div style="height:12px; width:70%; background:var(--ink); border-radius:3px; margin-bottom:12px;"></div>
<div style="height:44px; background:linear-gradient(135deg, #f0f0f0, var(--ink)); border-radius:8px; margin-bottom:10px;"></div>
<div class="am-cursor" style="bottom:34px; left:10px;">LeStudio</div>
</div>
<div class="am-toolbar">
<svg width="13" height="13" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M3 9h18M9 3v18M3 3h18v18H3z"/></svg>
<svg width="13" height="13" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M4 4h16v16H4z"/></svg>
<svg width="13" height="13" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M3 21l4-1 12-12-3-3L4 17z"/></svg>
<svg width="13" height="13" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M5 5h14M12 5v14"/></svg>
</div></div>
<div class="am-sticker" style="bottom:-14px; right:-10px;">Design system ✓</div></div>
{% else %}
<div class="am-wrap"><div class="asset-mock"><div class="am-chrome"><div class="am-dots"><span></span><span></span><span></span></div><div class="am-label"><svg width="10" height="10" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="m8 6l-6 6l6 6M16 6l6 6l-6 6"/></svg>Inspect</div></div>
<div class="am-body">
<div style="border:1.5px solid var(--ink); border-radius:6px; padding:10px; margin-bottom:10px; position:relative;">
<div style="height:8px; width:60%; background:var(--line); border-radius:3px; margin-bottom:6px;"></div>
<div style="height:8px; width:40%; background:var(--line); border-radius:3px;"></div>
<div style="position:absolute; top:-8px; right:-8px; background:var(--ink); color:#fff; font-size:8px; padding:2px 6px; border-radius:4px;">16px</div>
</div>
<div style="background:var(--ink); border-radius:6px; padding:8px 10px; font-family:monospace; font-size:9px; color:var(--paper-60); line-height:1.6; margin-bottom:12px;">padding: 16px<br>radius: 8px</div>
<div style="display:flex; gap:8px; flex-wrap:wrap;">
<span class="am-filetag"><svg width="11" height="11" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path fill="none" stroke="currentColor" stroke-width="2" d="M14 2v6h6"/></svg>Handoff.pdf</span>
<span class="am-filetag"><svg width="11" height="11" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path fill="none" stroke="currentColor" stroke-width="2" d="M14 2v6h6"/></svg>LeStudio.fig</span>
</div></div></div>
<div class="am-sticker" style="bottom:-14px; left:-12px;">Livré ✓</div></div>
{% endif %}
{% endmacro %}
