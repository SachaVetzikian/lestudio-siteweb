---
import Layout from "../../layouts/Layout.astro";
import { sanityClient, urlForImage } from "../../lib/sanity";
import { realisationsQuery } from "../../lib/queries";
import type { Realisation } from "../../lib/types";

const realisations = await sanityClient.fetch<Realisation[]>(realisationsQuery);
---

<Layout title="Réalisations — LeStudio" description="Réalisations publiées par LeStudio.">
  <main>
    <h1>Réalisations</h1>
    <ul class="card-list">
      {
        realisations.map((realisation) => (
          <li>
            <a href={`/realisations/${realisation.slug.current}/`}>
              {realisation.images?.[0] && (
                <img
                  src={urlForImage(realisation.images[0]).width(800).height(450).fit("crop").url()}
                  alt={realisation.images[0].alt ?? ""}
                  width="800"
                  height="450"
                />
              )}
              <h2>{realisation.titre}</h2>
              {realisation.categorieService && <p>{realisation.categorieService}</p>}
              {realisation.descriptionCourte && <p>{realisation.descriptionCourte}</p>}
            </a>
          </li>
        ))
      }
    </ul>
    {realisations.length === 0 && <p>Aucune réalisation publiée pour le moment.</p>}
  </main>
</Layout>
