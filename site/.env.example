# Identifiants du projet Sanity (voir manage.sanity.io)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-01-01

# Token API en lecture seule, requis uniquement si le dataset n'est pas public
# (Sanity > API > Tokens > créer un token "Viewer")
SANITY_API_READ_TOKEN=

# URL canonique du site en production, utilisée pour le sitemap et les balises SEO
PUBLIC_SITE_URL=https://www.lestudiodesign.fr
